material {
  name: "GhostPreview",
  shading_model: unlit,
  blending: alpha,
  culling: none,
  depth_write: false,
  depth_layer: 2,
  parameters: [
    { type: vec4, name: ghost_color, hint: source_color, default: [1.0, 0.72, 0.32, 0.42] },
    { type: float, name: time_sec, default: 0.0 }
  ]
}

fragment {
  void Surface(inout MaterialInputs material) {
    vec3 N = normalize(GetWorldNormal());
    vec3 V = GetViewDirection();
    vec4 vColor = GetVertexColor();
    float t = material_params.time_sec;
    float pulse = 0.92 + 0.08 * sin(t * 3.4);
    float fresnel = pow(clamp(1.0 - abs(dot(N, V)), 0.0, 1.0), 1.6);

    vec3 linearRgb =
        material_params.ghost_color.rgb * vColor.rgb * (0.76 + 0.18 * fresnel);
    float alpha = clamp(
      material_params.ghost_color.a * (0.78 + 0.22 * fresnel) * vColor.a * pulse,
      0.0,
      0.84
    );

    material.base_color = vec4(linearRgb, alpha);
    PrepareMaterial(material);
  }
}
