material {
  name: "GouacheLit",
  shading_model: lit,
  blending: opaque,
  culling: back,
  parameters: [
    { type: vec4, name: base_tint, hint: source_color, default: [0.85, 0.78, 0.68, 1.0] },
    { type: vec4, name: warm_tint, hint: source_color, default: [0.95, 0.82, 0.65, 1.0] },
    { type: float, name: roughness_val, default: 0.85 },
    { type: float, name: grain_scale, default: 8.0 },
    { type: float, name: weathering, default: 0.25 },
    { type: float, name: dew_sheen, default: 0.22 },
    { type: float, name: gust_strength, default: 1.0 },
    { type: float, name: time_sec, default: 0.0 },
    { type: float, name: style_id, default: 0.0 }
  ]
}

vertex {
  void Vertex(inout VertexInputs vertex) {
    if (material_params.style_id > 5.75 && material_params.style_id < 6.25) {
      float t = material_params.time_sec;
      vec3 wp = vertex.world_position;
      const vec2 windDir = vec2(0.7808688, 0.6246950);
      const vec2 crossDir = vec2(-0.6246950, 0.7808688);
      float phase = sin(wp.x * 0.28 + wp.z * 0.22) * 1.5;
      float breath = 0.5 + 0.5 * sin(t * 0.78 + phase);
      float ripple = sin(t * 1.35 - wp.y * 2.1 + wp.x * 0.9);
      float g = material_params.gust_strength;
      float push = (0.005 + 0.012 * breath + 0.004 * ripple) * g;
      vertex.world_position.xz += windDir * push + crossDir * (ripple * 0.005 * g);
    }
  }
}

fragment {
  #include <noise.glsl>

  void Surface(inout MaterialInputs material) {
    vec3 P = GetWorldPosition();
    vec3 N = normalize(GetWorldNormal());
    vec2 uv = GetUV0();
    vec4 vColor = GetVertexColor();

    vec3 upRef = abs(N.y) < 0.92 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(upRef, N));
    vec3 B = normalize(cross(N, T));

    float pigmentFbm = NoiseFbm3(
      P * (material_params.grain_scale * 0.24),
      1337,
      3,
      2.0,
      0.5
    );
    float pigment = clamp(0.5 + 0.5 * pigmentFbm, 0.0, 1.0);
    float microBrush = NoiseSimplex3(P * 9.5, 811) * 0.5 + 0.5;

    vec3 albedo = mix(
      material_params.base_tint.rgb,
      material_params.warm_tint.rgb,
      clamp(pigment * 0.52 + (microBrush - 0.5) * 0.16, 0.0, 1.0)
    );
    float rough = material_params.roughness_val + (pigment - 0.5) * 0.10;
    float spec = 0.42;
    vec3 perturbedN = N;
    float style = material_params.style_id;
    const float kStyleKawaraTile = 1.0;
    const float kStyleCedarTimber = 2.0;
    const float kStyleStoneMasonry = 3.0;
    const float kStyleEdoPlaster = 4.0;
    const float kStyleLaneThreshold = 5.25;
    const float kStyleDyedCloth = 6.0;

    if (abs(style - kStyleKawaraTile) < 0.5) {
      float uEave = dot(P, T);
      float vSlope = dot(P, B);
      if (vColor.a <= 0.45) {
        float reedWarp = NoiseSimplex3(P * 3.4, 331) * 0.65;
        float reedBundle = sin(uEave * 44.0 + reedWarp * 2.4) * 0.5 + 0.5;
        float reedFine = NoiseSimplex2(vec2(uEave * 26.0, vSlope * 5.5), 337) * 0.5 + 0.5;
        float layerFract = fract(vSlope / 0.46 + reedWarp * 0.12);
        float layerShadow = 1.0 - 0.26 * (1.0 - smoothstep(0.0, 0.18, layerFract));
        vec3 thatchDark = vec3(0.50, 0.38, 0.19);
        vec3 thatchGold = vec3(0.78, 0.62, 0.32);
        albedo = mix(thatchDark, thatchGold, clamp(reedBundle * 0.48 + reedFine * 0.52, 0.0, 1.0));
        albedo *= layerShadow * (0.88 + 0.22 * pigment);
        float thatchMoss = smoothstep(0.52, 0.84, pigment * 0.68 + reedFine * 0.32) * material_params.weathering;
        albedo = mix(albedo, vec3(0.14, 0.22, 0.08), thatchMoss * 0.62);
        float reedSlope = cos(uEave * 44.0 + reedWarp * 2.4) * 0.22;
        float stepKick = (1.0 - smoothstep(0.0, 0.16, layerFract)) * 0.26;
        perturbedN = normalize(N + T * reedSlope + B * (stepKick + (reedFine - 0.5) * 0.12));
        rough = clamp(0.89 + (reedFine - 0.5) * 0.08, 0.82, 0.94);
        spec = 0.24;
      } else if (vColor.a <= 0.85) {
        float shakeRow = floor(vSlope / 0.28);
        float shakeU = uEave / 0.15 + mod(shakeRow, 2.0) * 0.43;
        float shakeCol = floor(shakeU);
        float shakeFx = fract(shakeU);
        float shakeFy = fract(vSlope / 0.28);
        float shakeSeam = 1.0 - smoothstep(0.0, 0.11, min(shakeFx, 1.0 - shakeFx));
        float courseShadow = 1.0 - 0.36 * (1.0 - smoothstep(0.0, 0.14, shakeFy));
        float shakeVar = NoiseValue2(vec2(shakeCol * 1.3, shakeRow * 1.7), 347) * 0.5 + 0.5;
        float woodFiber = NoiseSimplex2(vec2(uEave * 18.0, vSlope * 6.2), 353) * 0.5 + 0.5;
        vec3 cedarUmber = vec3(0.24, 0.15, 0.09);
        vec3 cedarWarm = vec3(0.44, 0.28, 0.16);
        albedo = mix(cedarUmber, cedarWarm, clamp(shakeVar * 0.62 + woodFiber * 0.38, 0.0, 1.0));
        albedo *= courseShadow * (1.0 - 0.42 * shakeSeam) * (0.90 + 0.20 * pigment);
        float shakeMoss = smoothstep(0.58, 0.86, pigment * 0.65 + shakeVar * 0.35) * material_params.weathering;
        albedo = mix(albedo, vec3(0.10, 0.16, 0.06), shakeMoss * 0.58);
        float seamBevel = (shakeFx < 0.11 ? -1.0 : (shakeFx > 0.89 ? 1.0 : 0.0)) * shakeSeam;
        float stepKick = (1.0 - smoothstep(0.0, 0.12, shakeFy)) * 0.30;
        perturbedN = normalize(N + T * (seamBevel * 0.28 + (woodFiber - 0.5) * 0.10) + B * stepKick);
        rough = clamp(0.80 + shakeSeam * 0.10 - woodFiber * 0.06, 0.68, 0.93);
        spec = 0.34;
      } else if (abs(N.y) < 0.95) {
        float ribPhase = uEave * (6.2831853 / 0.26);
        float ribWave = cos(ribPhase);
        float ribSlope = -sin(ribPhase);

        float courseFract = fract(vSlope / 0.34);
        float courseLip = smoothstep(0.0, 0.11, courseFract) * (1.0 - smoothstep(0.88, 1.0, courseFract));
        float overlapShadow = 1.0 - 0.34 * (1.0 - smoothstep(0.0, 0.14, courseFract));

        float tileVar = NoiseValue2(
          vec2(floor(uEave / 0.26), floor(vSlope / 0.34)),
          313
        ) * 0.5 + 0.5;
        float mossMask = smoothstep(0.62, 0.88, pigment * 0.65 + tileVar * 0.35) * material_params.weathering;

        float crownLight = 0.76 + 0.34 * (ribWave * 0.5 + 0.5);
        vec3 warmFired = albedo * vec3(1.22, 1.06, 0.94);
        albedo = mix(albedo, warmFired, smoothstep(0.55, 0.92, tileVar) * 0.45);
        albedo *= crownLight * overlapShadow * (0.88 + 0.24 * tileVar);
        albedo = mix(albedo, vec3(0.08, 0.13, 0.06), mossMask * 0.55);

        float stepKick = (1.0 - smoothstep(0.0, 0.10, courseFract)) * 0.32;
        perturbedN = normalize(N + T * (ribSlope * 0.34) + B * (stepKick * (courseLip * 0.2 + 0.8)));
        rough = mix(0.36, 0.78, (1.0 - (ribWave * 0.5 + 0.5)) * 0.7 + mossMask * 0.3);
        spec = 0.64;
      }
    } else if (abs(style - kStyleCedarTimber) <= 0.5) {
      float boardCoord = abs(N.y) < 0.55 ? dot(P, T) / 0.21 : dot(P, T) / 0.24;
      float grainCoord = abs(N.y) < 0.55 ? P.y * 2.2 : dot(P, B) * 1.8;
      float boardFract = fract(boardCoord);
      float boardId = floor(boardCoord);
      float seam = 1.0 - smoothstep(0.0, 0.09, min(boardFract, 1.0 - boardFract));
      float boardTone = NoiseValue2(vec2(boardId, floor(grainCoord * 0.2)), 401) * 0.5 + 0.5;
      float woodGrain = NoiseSimplex2(vec2(boardCoord * 3.5, grainCoord * 4.8), 419) * 0.5 + 0.5;

      albedo *= (0.82 + 0.34 * boardTone) * (0.88 + 0.22 * woodGrain) * (1.0 - 0.42 * seam);
      float bevel = (boardFract < 0.09 ? -1.0 : (boardFract > 0.91 ? 1.0 : 0.0)) * seam;
      perturbedN = normalize(N + T * (bevel * 0.26 + (woodGrain - 0.5) * 0.08));
      rough = clamp(rough + seam * 0.12 - woodGrain * 0.06, 0.35, 0.96);
    } else if (abs(style - kStyleStoneMasonry) < 0.5) {
      bool isCutMasonry = vColor.a > 0.75;
      if (isCutMasonry) {
        float uStone = dot(P, T);
        float vStone = abs(N.y) < 0.82 ? P.y : dot(P, B);
        float row = floor(vStone / 0.44);
        float wobble = NoiseSimplex2(vec2(uStone * 0.9, vStone * 0.9), 509) * 0.14;
        float colCoord = (uStone + wobble) / 0.66 + mod(row, 2.0) * 0.47;
        float rowCoord = (vStone + wobble * 0.6) / 0.44;
        float fx = fract(colCoord);
        float fy = fract(rowCoord);
        float col = floor(colCoord);

        float edgeX = min(fx, 1.0 - fx);
        float edgeY = min(fy, 1.0 - fy);
        float mortar = 1.0 - smoothstep(0.02, 0.11, min(edgeX, edgeY * 0.85));
        float stoneHash = NoiseValue2(vec2(col * 1.3, row * 1.7), 521) * 0.5 + 0.5;
        float rockFacet = NoiseSimplex3(P * 2.6, 547);

        vec3 warmGranite = albedo * vec3(1.22, 1.08, 0.90);
        vec3 coolSlate = albedo * vec3(0.80, 0.92, 1.10);
        albedo = mix(coolSlate, warmGranite, stoneHash);
        albedo *= (0.86 + 0.26 * (rockFacet * 0.5 + 0.5)) * (1.0 - 0.56 * mortar);

        float dampMoss = smoothstep(0.45, -0.35, P.y) * 0.55 +
            smoothstep(0.58, 0.86, pigment) * material_params.weathering * 0.65;
        albedo = mix(albedo, vec3(0.065, 0.125, 0.048), clamp(dampMoss * (0.45 + 0.55 * mortar), 0.0, 0.72));

        float bevelX = (fx < 0.12 ? -1.0 : (fx > 0.88 ? 1.0 : 0.0)) * (1.0 - smoothstep(0.0, 0.12, edgeX));
        float bevelY = (fy < 0.14 ? -1.0 : (fy > 0.86 ? 1.0 : 0.0)) * (1.0 - smoothstep(0.0, 0.14, edgeY));
        perturbedN = normalize(N + T * (bevelX * 0.36 + rockFacet * 0.10) + B * (bevelY * 0.34));
        rough = mix(0.68, 0.95, mortar * 0.7 + dampMoss * 0.3);
      } else {
        float strataFbm = NoiseFbm3(vec3(P.x * 0.85, P.y * 1.15, P.z * 0.85), 563, 3, 2.0, 0.5);
        float rockWarp = NoiseSimplex3(P * 0.95 + vec3(3.7, -2.1, 1.9), 569);
        vec3 rockP = P * 1.58 + vec3(strataFbm * 0.64, rockWarp * 0.48, -strataFbm * 0.56);

        float cellDist = NoiseCellular3(
          rockP,
          571,
          kNoiseCellularEuclidean,
          kNoiseCellularDistance2Sub,
          0.94
        );
        float cellFine = NoiseCellular3(
          rockP * 2.15 + vec3(2.4, -1.7, 1.1),
          587,
          kNoiseCellularEuclidean,
          kNoiseCellularDistance2Sub,
          0.92
        );
        float crackDist = max(0.0, cellDist + 1.0);
        float fineCrackDist = max(0.0, cellFine + 1.0);
        float fissureMask = clamp(
          (1.0 - smoothstep(0.015, 0.13, crackDist)) +
              (1.0 - smoothstep(0.01, 0.08, fineCrackDist)) * 0.48,
          0.0,
          1.0
        );

        float strata = strataFbm;
        float shelfCoord = (P.y * 0.76 + P.x * 0.24 - P.z * 0.19) + strataFbm * 0.84 + rockWarp * 0.46;
        float shelfFract = fract(shelfCoord);
        float bedPlane = shelfFract;
        float bedCrevice = 1.0 - smoothstep(0.0, 0.16, bedPlane);
        float shelfRiser = smoothstep(0.76, 0.98, shelfFract);
        float shelfLedge = 1.0 - smoothstep(0.0, 0.14, abs(shelfFract - 0.76));

        float totalCrevice = clamp(fissureMask * 0.75 + shelfRiser * 0.55, 0.0, 1.0);

        float facetGrain = NoiseSimplex3(rockP * 1.85, 577);
        float facetMicro = NoiseSimplex3(P * 7.8, 593);

        float fissureKickT = (NoiseSimplex3(rockP + vec3(0.32, 0.0, 0.0), 571) - 0.5) * fissureMask;
        float fissureKickB = (NoiseSimplex3(rockP + vec3(0.0, 0.32, 0.0), 573) - 0.5) * fissureMask;
        float shelfNormY = (shelfRiser * 2.0 - 1.0) * 0.28 + strata * 0.08;

        vec3 normalDelta = T * (fissureKickT * 0.44 + facetGrain * 0.18) +
                           B * (shelfNormY + strataFbm * 0.18 + facetMicro * 0.09 + fissureKickB * 0.24);
        perturbedN = normalize(N + normalDelta * 1.45);

        float crownSun = clamp(N.y * 0.68 + 0.32, 0.0, 1.0);
        vec3 slateBelly = albedo * vec3(0.70, 0.80, 0.98);
        vec3 ochreCrown = albedo * vec3(1.58, 1.28, 0.86);
        albedo = mix(slateBelly, ochreCrown, crownSun * (0.60 + 0.40 * (strataFbm * 0.5 + 0.5)));
        albedo *= (0.88 + 0.24 * (facetGrain * 0.5 + 0.5)) * (1.0 - bedCrevice * 0.14);

        vec3 deepIndigoUmber = vec3(0.038, 0.032, 0.048);
        albedo = mix(albedo, deepIndigoUmber, totalCrevice * 0.68);

        float mossNoise = NoiseSimplex3(P * 2.4 + vec3(strataFbm * 0.4), 883) * 0.5 + 0.5;
        float mossPocket = smoothstep(0.46, 0.76, mossNoise) *
                           smoothstep(0.18, 0.86, crownSun) *
                           (1.0 - fissureMask * 0.60) *
                           (0.42 + 0.58 * shelfLedge) *
                           material_params.weathering;
        vec3 oliveMoss = vec3(0.088, 0.148, 0.050);
        albedo = mix(albedo, oliveMoss, clamp(mossPocket * 0.78, 0.0, 0.72));

        rough = mix(0.86, 0.52, totalCrevice * 0.60);
        rough = mix(rough, 0.94, mossPocket * 0.50);

        float riverDamp = smoothstep(-0.15, -0.58, P.y);
        rough = mix(rough, 0.38, riverDamp * 0.85);
        albedo = mix(albedo, albedo * 0.72, riverDamp * 0.40);
      }
    } else if (abs(style - kStyleEdoPlaster) <= 0.5) {
      float trowel = NoiseSimplex3(vec3(P.x * 2.8, P.y * 4.6, P.z * 2.8), 601);
      float splashMask = clamp(1.0 - uv.y * 2.8, 0.0, 1.0) * material_params.weathering;
      albedo *= 0.94 + 0.10 * trowel;
      albedo = mix(albedo, albedo * vec3(0.56, 0.50, 0.44), splashMask * 0.65);
      perturbedN = normalize(N + T * (trowel * 0.06));
    } else if (style > 4.5 && style < 5.8) {
      float isLane = step(kStyleLaneThreshold, style);
      vec2 warp = vec2(
        NoiseSimplex2(P.xz * 0.10, 683),
        NoiseSimplex2(P.xz * 0.10, 691)
      ) * 2.9;

      float clodCell = NoiseCellular2(
        P.xz * 3.8,
        719,
        kNoiseCellularEuclidean,
        kNoiseCellularCellValue,
        0.75
      ) * 0.5 + 0.5;
      float pebbleSpeck = smoothstep(0.68, 0.92, NoiseSimplex2(P.xz * 5.8, 787) * 0.5 + 0.5);
      float fineGrit = NoiseSimplex2(P.xz * 9.2, 733);

      if (isLane > 0.5) {
        float edgeDist = abs(uv.x - 0.5) * 2.0;
        float edgeWear = edgeDist;
        bool isGardenPath = vColor.a < 0.60;

        if (isGardenPath) {
          float rakeWave = sin(uv.x * 56.0 + fineGrit * 0.60);
          float vergeMix = smoothstep(0.64, 0.96, edgeDist);
          vec3 gravelBed = mix(vec3(0.32, 0.26, 0.18), vec3(0.44, 0.36, 0.26), clodCell);
          gravelBed *= 0.92 + 0.08 * rakeWave;
          vec3 mossyVerge = mix(vec3(0.095, 0.138, 0.052), vec3(0.18, 0.15, 0.10), clodCell * 0.5);
          albedo = mix(gravelBed, mossyVerge, vergeMix);
          float rakeSlope = cos(uv.x * 56.0) * (1.0 - vergeMix) * 0.18;
          perturbedN = normalize(N + T * (rakeSlope + fineGrit * 0.08) + B * ((clodCell - 0.5) * 0.14));
          rough = mix(0.85, 0.93, vergeMix);
        } else {
          float rutDist = abs(edgeDist - 0.42);
          float rutGouge = exp(-pow(rutDist * 7.5, 2.0));
          float rutPair = rutGouge;
          float rutSpill = exp(-pow((rutDist - 0.14) * 9.0, 2.0)) * 0.45;
          float shoulder = smoothstep(0.72, 0.98, edgeDist);
          float shoulderMix = shoulder;

          float rutSlope = (edgeDist - 0.42) * rutGouge * (uv.x < 0.5 ? -0.32 : 0.32);
          float clodRelief = (clodCell - 0.5) * 0.22;
          float pebbleRelief = pebbleSpeck * 0.24;
          float bermDisplacement = (rutSpill - rutGouge * 0.20) * 0.25;

          vec3 soilNormalDelta = T * (rutSlope + fineGrit * 0.08) +
                                 B * (clodRelief + pebbleRelief + bermDisplacement);
          perturbedN = normalize(N + soilNormalDelta * 1.55);

          vec3 warmTerracotta = albedo * vec3(1.34, 1.10, 0.82);
          vec3 coolDampUmber = albedo * vec3(0.68, 0.60, 0.52);
          vec3 rutSoil = mix(warmTerracotta, coolDampUmber, clamp(rutGouge * 0.78 + shoulder * 0.32, 0.0, 1.0));
          vec3 embeddedStone = mix(vec3(0.20, 0.18, 0.16), vec3(0.32, 0.28, 0.24), clodCell);
          albedo = mix(rutSoil, embeddedStone, pebbleSpeck * 0.48);
          albedo = mix(albedo, vec3(0.108, 0.135, 0.058), shoulder * 0.36);

          float puddleNoise = NoiseSimplex2(P.xz * 1.25 + warp * 0.15, 853) * 0.5 + 0.5;
          float rutPuddleMask = smoothstep(0.48, 0.78, puddleNoise * rutGouge) *
                                smoothstep(0.82, 0.98, N.y);

          rough = mix(mix(0.88, 0.68, rutGouge * 0.55), 0.08, rutPuddleMask);
          spec = mix(0.42, 0.85, rutPuddleMask);
          albedo = mix(albedo, vec3(0.065, 0.075, 0.085), rutPuddleMask * 0.65);
          perturbedN = mix(perturbedN, vec3(0.0, 1.0, 0.0), rutPuddleMask * 0.92);
        }
      } else {
        float wear = clamp(vColor.a, 0.0, 1.0);
        float macroZone = NoiseFbm2((P.xz + warp) * 0.12, 701, 3, 2.0, 0.5) * 0.5 + 0.5;
        float soilPatch = NoiseFbm2((P.xz - warp * 0.55) * 0.34, 761, 3, 2.0, 0.5) * 0.5 + 0.5;
        float mossDetail = NoiseSimplex2(vec2(P.x * 1.45 + P.z * 0.55, P.z * 1.45 - P.x * 0.55), 769) * 0.5 + 0.5;
        float leafSpeck = smoothstep(0.86, 0.93, NoiseSimplex2(P.xz * 4.8, 793) * 0.5 + 0.5)
          * (1.0 - wear * 0.80);

        float clodRelief = (clodCell - 0.5) * 0.24;
        float pebbleRelief = pebbleSpeck * (0.16 + 0.28 * wear);

        vec3 terrainNormalDelta = vec3(
          clodRelief + fineGrit * 0.08,
          0.0,
          pebbleRelief + (soilPatch - 0.5) * 0.18
        );
        perturbedN = normalize(N + terrainNormalDelta * 1.45);

        vec3 warmTerracottaSoil = albedo * vec3(1.30, 1.10, 0.84);
        vec3 coolDampLoam = albedo * vec3(0.70, 0.62, 0.54);
        albedo = mix(coolDampLoam, warmTerracottaSoil, soilPatch * 0.65);

        float meadowTurfMask = smoothstep(0.30, 0.72, (1.0 - macroZone) * 0.58 + mossDetail * 0.42)
          * (1.0 - wear * 0.86);
        vec3 oliveTurf = vec3(0.088, 0.118, 0.048) + vec3(0.036, 0.038, 0.014) * soilPatch;
        albedo = mix(albedo, oliveTurf, meadowTurfMask * 0.62);
        vec3 wornEarth = albedo * vec3(1.26, 1.08, 0.86);
        albedo = mix(albedo, wornEarth, wear * 0.52);

        albedo = mix(albedo, vec3(0.245, 0.215, 0.175), pebbleSpeck * (0.18 + 0.40 * wear));
        albedo = mix(albedo, vec3(0.36, 0.165, 0.052), leafSpeck * 0.48);

        float wetShore = smoothstep(0.08, -0.58, P.y);
        albedo = mix(albedo, vec3(0.064, 0.070, 0.065), wetShore * 0.76);

        float fieldPuddleMask = smoothstep(0.68, 0.90, NoiseSimplex2(P.xz * 0.95, 911) * 0.5 + 0.5) *
                                (1.0 - wear * 0.60) *
                                smoothstep(0.85, 0.99, N.y);

        rough = mix(mix(0.88, 0.82, wear * 0.40), 0.32, wetShore * 0.78);
        rough = mix(rough, 0.08, fieldPuddleMask);
        spec = mix(spec, 0.85, fieldPuddleMask);
        albedo = mix(albedo, vec3(0.068, 0.076, 0.082), fieldPuddleMask * 0.60);
        perturbedN = mix(perturbedN, vec3(0.0, 1.0, 0.0), fieldPuddleMask * 0.88);
      }
    } else if (style >= 5.8) {
      if (abs(style - kStyleDyedCloth) < 0.25) {
        if (vColor.a < 0.75) {
          albedo = mix(vec3(0.82, 0.79, 0.74), vec3(0.96, 0.93, 0.88), pigment);
        }
        float stripe = sin(uv.x * 37.699) * 0.5 + 0.5;
        float weave = NoiseSimplex2(uv * 48.0, 809) * 0.08;
        albedo *= (0.88 + 0.22 * smoothstep(0.35, 0.65, stripe) + weave);
      } else {
        rough = 0.42;
        spec = 0.68;
      }
    }

    float wallDripMask = smoothstep(0.88, 0.42, abs(N.y));
    float dripNoise = NoiseSimplex2(vec2(P.x * 1.4 + P.z * 1.4, P.y * 2.6), 42);
    float drip = clamp(0.5 + 0.5 * dripNoise, 0.0, 1.0) * material_params.weathering * wallDripMask;
    vec3 weathered = mix(albedo, albedo * 0.76, drip * 0.32);

    float upMoisture = smoothstep(0.35, 0.92, perturbedN.y) * material_params.dew_sheen;
    float dewHold = (style > 0.5 && style < 3.5) || style > kStyleLaneThreshold ? 0.44 : 0.18;
    float moistureMix = upMoisture * dewHold;
    rough = mix(rough, min(rough, 0.20), moistureMix);
    spec = mix(spec, max(spec, 0.76), moistureMix);

    material.base_color = vec4(weathered * vColor.rgb, 1.0);
    material.normal = perturbedN;
    material.metallic = 0.0;
    material.roughness = clamp(rough, 0.08, 0.94);
    material.specular = spec;

    PrepareMaterial(material);
  }
}
