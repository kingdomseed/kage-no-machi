material {
  name: "GouacheLit",
  shading_model: lit,
  blending: opaque,
  culling: back,
  parameters: [
    { type: vec4, name: base_tint, hint: source_color, default: [0.85, 0.78, 0.68, 1.0] },
    { type: vec4, name: warm_tint, hint: source_color, default: [0.95, 0.82, 0.65, 1.0] },
    { type: float, name: roughness_val, default: 0.85 },
    { type: float, name: grain_scale, default: 8.0 },
    { type: float, name: weathering, default: 0.25 },
    { type: float, name: dew_sheen, default: 0.22 },
    { type: float, name: gust_strength, default: 1.0 },
    { type: float, name: time_sec, default: 0.0 },
    { type: float, name: style_id, default: 0.0 }
  ]
}

vertex {
  void Vertex(inout VertexInputs vertex) {
    if (material_params.style_id > 5.75 && material_params.style_id < 6.25) {
      float t = material_params.time_sec;
      vec3 wp = vertex.world_position;
      const vec2 windDir = vec2(0.7808688, 0.6246950);
      const vec2 crossDir = vec2(-0.6246950, 0.7808688);
      float phase = sin(wp.x * 0.28 + wp.z * 0.22) * 1.5;
      float breath = 0.5 + 0.5 * sin(t * 0.78 + phase);
      float ripple = sin(t * 1.35 - wp.y * 2.1 + wp.x * 0.9);
      float g = material_params.gust_strength;
      float push = (0.005 + 0.012 * breath + 0.004 * ripple) * g;
      vertex.world_position.xz += windDir * push + crossDir * (ripple * 0.005 * g);
    }
  }
}

fragment {
  #include <noise.glsl>
  precision highp float;

  const float kStyleKawaraTile = 1.0;
  const float kStyleCedarTimber = 2.0;
  const float kStyleStoneMasonry = 3.0;
  const float kStyleEdoPlaster = 4.0;
  const float kStyleLaneThreshold = 5.25;
  const float kStyleDyedCloth = 6.0;

  float ComputeAtmosphericGobo(vec2 worldXZ, float t) {
    float cloudMacro = NoiseFbm2(
      worldXZ * 0.028 + vec2(t * 0.012, -t * 0.008),
      1103,
      3,
      2.0,
      0.5
    ) * 0.5 + 0.5;
    float cloudClearing = smoothstep(0.28, 0.74, cloudMacro);
    float woodlandZone = clamp(
      smoothstep(5.5, 16.0, abs(worldXZ.y)) * 0.72 +
          smoothstep(18.0, 38.0, length(worldXZ)) * 0.48,
      0.18,
      1.0
    );
    float canopyBough = NoiseSimplex2(
      worldXZ * 0.24 + vec2(t * 0.032, t * 0.019),
      1117
    ) * 0.5 + 0.5;
    float canopyLeafGap = NoiseSimplex2(
      worldXZ * 0.62 - vec2(t * 0.048, -t * 0.026),
      1129
    ) * 0.5 + 0.5;
    float canopyDapple = smoothstep(0.26, 0.78, canopyBough * 0.64 + canopyLeafGap * 0.36);
    return mix(
      cloudClearing,
      cloudClearing * (0.56 + 0.44 * canopyDapple),
      woodlandZone * 0.68
    );
  }

  float ReliefDepthForStyle(float style, vec3 N, vec4 vColor) {
    if (abs(style - kStyleKawaraTile) < 0.5) {
      if (vColor.a <= 0.45) {
        return 0.040;
      }
      if (vColor.a <= 0.85) {
        return 0.028;
      }
      return abs(N.y) < 0.95 ? 0.036 : 0.010;
    }
    if (abs(style - kStyleCedarTimber) <= 0.5) {
      return 0.014;
    }
    if (abs(style - kStyleStoneMasonry) < 0.5) {
      return vColor.a > 0.75 ? 0.042 : 0.048;
    }
    if (style > 4.5 && style < 5.8) {
      return style > kStyleLaneThreshold ? 0.038 : 0.034;
    }
    return 0.0;
  }

  float SampleReliefHeight(
    vec3 sp,
    vec2 suv,
    vec3 N,
    vec3 T,
    vec3 B,
    vec4 vColor,
    float style,
    vec2 laneBlend,
    float detailWeight
  ) {
    if (abs(style - kStyleKawaraTile) < 0.5) {
      float uEave = dot(sp, T);
      float vSlope = dot(sp, B);
      if (vColor.a <= 0.45) {
        float reedWarp = NoiseSimplex3(sp * 3.4, 331) * 0.65;
        float reedBundle = mix(
          0.5,
          sin(uEave * 44.0 + reedWarp * 2.4) * 0.5 + 0.5,
          detailWeight
        );
        float layerFract = fract(vSlope / 0.46 + reedWarp * 0.12);
        float stepProfile = smoothstep(0.0, 0.22, layerFract) * (1.0 - 0.35 * layerFract);
        return clamp(0.26 + 0.50 * stepProfile + 0.24 * reedBundle, 0.0, 1.0);
      }
      if (vColor.a <= 0.85) {
        float shakeRow = floor(vSlope / 0.28);
        float shakeU = uEave / 0.15 + mod(shakeRow, 2.0) * 0.43;
        float shakeFx = fract(shakeU);
        float shakeFy = fract(vSlope / 0.28);
        float shakeSeam = (1.0 - smoothstep(0.0, 0.11, min(shakeFx, 1.0 - shakeFx))) * detailWeight;
        float courseRamp = smoothstep(0.0, 0.16, shakeFy) * (1.0 - 0.32 * shakeFy);
        return clamp((0.28 + 0.72 * courseRamp) * (1.0 - 0.64 * shakeSeam), 0.0, 1.0);
      }
      if (abs(N.y) < 0.95) {
        float ribWave = cos(uEave * (6.2831853 / 0.26)) * 0.5 + 0.5;
        float courseFract = fract(vSlope / 0.34);
        float courseRamp = smoothstep(0.0, 0.14, courseFract) * (1.0 - 0.28 * courseFract);
        return clamp(0.16 + 0.54 * ribWave + 0.30 * courseRamp, 0.0, 1.0);
      }
      return 0.85;
    }

    if (abs(style - kStyleCedarTimber) <= 0.5) {
      float boardCoord = abs(N.y) < 0.55 ? dot(sp, T) / 0.21 : dot(sp, T) / 0.24;
      float boardFract = fract(boardCoord);
      float seam = (1.0 - smoothstep(0.0, 0.09, min(boardFract, 1.0 - boardFract))) * detailWeight;
      float lap = 1.0 - 0.22 * boardFract;
      return clamp(lap * (1.0 - 0.68 * seam), 0.0, 1.0);
    }

    if (abs(style - kStyleStoneMasonry) < 0.5) {
      if (vColor.a > 0.75) {
        float uStone = dot(sp, T);
        float vStone = abs(N.y) < 0.82 ? sp.y : dot(sp, B);
        float row = floor(vStone / 0.44);
        float wobble = NoiseSimplex2(vec2(uStone * 0.9, vStone * 0.9), 509) * 0.14;
        float colCoord = (uStone + wobble) / 0.66 + mod(row, 2.0) * 0.47;
        float rowCoord = (vStone + wobble * 0.6) / 0.44;
        float fx = fract(colCoord);
        float fy = fract(rowCoord);
        float col = floor(colCoord);
        float edgeDist = min(min(fx, 1.0 - fx), min(fy, 1.0 - fy) * 0.85);
        float pillow = smoothstep(0.02, 0.20, edgeDist);
        float stoneHash = NoiseValue2(vec2(col * 1.3, row * 1.7), 521) * 0.5 + 0.5;
        float facet = NoiseSimplex3(sp * 2.6, 547) * 0.10 * detailWeight;
        return clamp(pillow * (0.72 + 0.24 * stoneHash + facet), 0.0, 1.0);
      }
      float strataFbm = NoiseFbm3(vec3(sp.x * 0.85, sp.y * 1.15, sp.z * 0.85), 563, 2, 2.0, 0.5);
      vec3 rockP = sp * 1.58 + vec3(strataFbm * 0.64, 0.0, -strataFbm * 0.56);
      float cellDist = NoiseCellular3(
        rockP,
        571,
        kNoiseCellularEuclidean,
        kNoiseCellularDistance2Sub,
        0.94
      );
      float crack = 1.0 - smoothstep(0.015, 0.14, max(0.0, cellDist + 1.0));
      float shelfFract = fract((sp.y * 0.76 + sp.x * 0.24 - sp.z * 0.19) + strataFbm * 0.84);
      float shelfStep = smoothstep(0.0, 0.18, shelfFract) *
          (1.0 - 0.36 * smoothstep(0.76, 0.98, shelfFract));
      return clamp((0.36 + 0.64 * shelfStep) * (1.0 - 0.78 * crack), 0.0, 1.0);
    }

    if (style > 4.5 && style < 5.8) {
      float clodH = NoiseSimplex2(sp.xz * 2.9, 719) * 0.5 + 0.5;
      float scourMass = smoothstep(0.44, 0.78, NoiseSimplex2(sp.xz * 0.68, 757) * 0.5 + 0.5);
      float cobbleDist = max(
        0.0,
        NoiseCellular2(sp.xz * 5.2, 787, kNoiseCellularEuclidean, kNoiseCellularDistance, 0.88) + 1.0
      );
      float cobbleDome = (1.0 - smoothstep(0.06, 0.34, cobbleDist)) * scourMass * detailWeight;
      float wearHint = style > kStyleLaneThreshold ? 0.25 : clamp(vColor.a, 0.0, 1.0);
      float turfPillow = smoothstep(0.24, 0.62, NoiseSimplex2(sp.xz * 0.42, 769) * 0.5 + 0.5) *
          (1.0 - wearHint * 0.85);
      float groundH = clamp(0.44 + 0.24 * clodH + 0.28 * cobbleDome + 0.14 * turfPillow, 0.0, 1.0);
      if (style <= kStyleLaneThreshold) {
        return groundH;
      }
      float edgeDist = abs(suv.x - 0.5) * 2.0;
      float rutDist = abs(edgeDist - 0.42);
      float rutGouge = exp(-pow(rutDist * 7.5, 2.0));
      float rutSpill = exp(-pow((rutDist - 0.14) * 9.0, 2.0)) * 0.45;
      float kaidoH = clamp(
        0.58 - 0.52 * rutGouge + 0.24 * rutSpill + 0.16 * clodH + 0.26 * cobbleDome,
        0.0,
        1.0
      );
      float rakeH = mix(0.5, sin(suv.x * 56.0) * 0.5 + 0.5, detailWeight);
      float vergeMix = smoothstep(0.64, 0.96, edgeDist);
      float gardenH = clamp(
        0.50 + 0.24 * rakeH * (1.0 - vergeMix) + 0.18 * clodH + 0.18 * vergeMix,
        0.0,
        1.0
      );
      float roadMix = vColor.a < 0.60 ? smoothstep(0.0, 1.0, laneBlend.y) : 1.0;
      float laneH = mix(gardenH, kaidoH, roadMix);
      return mix(laneH, groundH, smoothstep(0.0, 1.0, laneBlend.x));
    }

    return 1.0;
  }

  void EvaluateNaturalGround(
    vec3 P,
    vec3 N,
    vec2 warp,
    vec3 soilTint,
    float wear,
    float clodCell,
    float fineGrit,
    float fineFade,
    float midFade,
    out vec3 outAlbedo,
    out vec3 outNormal,
    out float outRough,
    out float outSpec,
    out float outAo
  ) {
    float macroZone = NoiseFbm2((P.xz + warp) * 0.105, 701, 3, 2.0, 0.5) * 0.5 + 0.5;
    float soilPatch = NoiseFbm2((P.xz - warp * 0.55) * 0.34, 761, 3, 2.0, 0.5) * 0.5 + 0.5;
    float turfMedium = NoiseFbm2((P.xz - warp * 0.38) * 0.42, 769, 2, 2.0, 0.5) * 0.5 + 0.5;
    float cloverFine = mix(
      0.5,
      NoiseSimplex2(vec2(P.x * 2.15 + P.z * 0.65, P.z * 2.15 - P.x * 0.65), 773) * 0.5 + 0.5,
      midFade
    );
    float riverBankLush = smoothstep(1.85, -0.28, P.y) * (1.0 - smoothstep(-0.30, -0.58, P.y));

    float turfSignal = (1.0 - macroZone) * 0.44 +
        turfMedium * 0.36 +
        cloverFine * 0.20 +
        riverBankLush * 0.22;
    float meadowTurfMask = smoothstep(0.40, 0.56, turfSignal) * (1.0 - wear * 0.86);

    float soilWorley = NoiseCellular2(
      P.xz * 2.65 + warp * 0.22,
      743,
      kNoiseCellularEuclidean,
      kNoiseCellularDistance2Sub,
      0.92
    );
    float crackEdge = 1.0 - smoothstep(0.012, 0.088, max(0.0, soilWorley + 1.0));
    float crackRegion = smoothstep(0.42, 0.74, soilPatch * 0.64 + wear * 0.46) *
        (1.0 - meadowTurfMask * 0.78);
    float crackBreaker = smoothstep(0.30, 0.68, NoiseSimplex2(P.xz * 4.4, 751) * 0.5 + 0.5);
    float soilCrackMask = crackEdge * crackRegion * crackBreaker * mix(0.25, 1.0, fineFade);

    float wetShore = smoothstep(0.08, -0.58, P.y);
    float scourMass = smoothstep(
      0.44,
      0.78,
      NoiseFbm2(P.xz * 0.68 + warp * 0.18, 757, 2, 2.0, 0.5) * 0.5 + 0.5 +
          wear * 0.28 +
          wetShore * 0.30
    );
    float cobbleDist = max(
      0.0,
      NoiseCellular2(P.xz * 5.2, 787, kNoiseCellularEuclidean, kNoiseCellularDistance, 0.88) + 1.0
    );
    float cobbleRadius = (0.22 + 0.20 * clodCell) * scourMass;
    float cobbleMask = (1.0 - smoothstep(cobbleRadius * 0.45, max(cobbleRadius, 0.04), cobbleDist)) *
        step(0.03, cobbleRadius) *
        mix(0.35, 1.0, fineFade);
    float cobbleRim = smoothstep(cobbleRadius * 0.45, cobbleRadius * 1.15, cobbleDist) *
        (1.0 - smoothstep(cobbleRadius * 1.15, cobbleRadius * 1.65, cobbleDist)) *
        step(0.05, cobbleRadius) *
        midFade;

    float leafSpeck = smoothstep(0.86, 0.93, NoiseSimplex2(P.xz * 4.8, 793) * 0.5 + 0.5) *
        (1.0 - wear * 0.80) *
        fineFade;

    vec3 deepForestHumus = soilTint * vec3(0.46, 0.42, 0.36);
    vec3 richChestnutLoam = soilTint * vec3(0.78, 0.68, 0.56);
    vec3 sunWarmClay = soilTint * vec3(1.16, 0.98, 0.76);
    vec3 soilBase = mix(deepForestHumus, richChestnutLoam, smoothstep(0.18, 0.72, soilPatch));
    soilBase = mix(soilBase, sunWarmClay, clamp(soilPatch * 0.38 + wear * 0.52, 0.0, 0.85));

    vec3 deepVelvetMoss = vec3(0.042, 0.088, 0.034);
    vec3 lushEmeraldClover = vec3(0.072, 0.144, 0.048);
    vec3 sunlitOliveSedge = vec3(0.124, 0.168, 0.054);
    vec3 livingTurf = mix(deepVelvetMoss, lushEmeraldClover, smoothstep(0.25, 0.75, cloverFine));
    livingTurf = mix(livingTurf, sunlitOliveSedge, smoothstep(0.42, 0.86, turfMedium) * 0.64);

    vec3 albedo = mix(soilBase, livingTurf, meadowTurfMask * 0.88);
    albedo = mix(albedo, vec3(0.030, 0.024, 0.020), soilCrackMask * 0.76);

    vec3 riverCobbleTone = mix(vec3(0.155, 0.148, 0.142), vec3(0.265, 0.232, 0.192), clodCell);
    albedo = mix(albedo, riverCobbleTone, cobbleMask * (0.42 + 0.40 * wear));
    albedo = mix(albedo, vec3(0.34, 0.155, 0.048), leafSpeck * 0.46);
    albedo = mix(albedo, vec3(0.064, 0.070, 0.065), wetShore * 0.78);

    float clodSlopeX = (clodCell - 0.5) * 0.28 * midFade;
    float clodSlopeZ = (cloverFine - 0.5) * 0.22 * midFade + (soilPatch - 0.5) * 0.18;
    float crackKick = soilCrackMask * 0.34;
    float cobbleKick = cobbleMask * 0.30;
    vec3 terrainNormalDelta = vec3(
      clodSlopeX + fineGrit * 0.09 * fineFade - crackKick * 0.5,
      0.0,
      clodSlopeZ + cobbleKick + crackKick * 0.5
    );
    vec3 groundN = normalize(N + terrainNormalDelta * 1.48);

    float fieldPuddleMask = smoothstep(0.66, 0.92, NoiseSimplex2(P.xz * 0.95, 911) * 0.5 + 0.5) *
        smoothstep(0.42, 0.80, wear) *
        smoothstep(0.85, 0.99, N.y) *
        smoothstep(0.65, 0.15, P.y);

    float groundRough = mix(mix(0.91, 0.82, wear * 0.42), 0.30, wetShore * 0.80);
    groundRough = mix(groundRough, 0.94, meadowTurfMask * 0.35);
    groundRough = mix(groundRough, 0.70, cobbleMask * 0.45);
    groundRough = mix(groundRough, 0.26, fieldPuddleMask);

    float groundSpec = mix(0.38, 0.52, fieldPuddleMask);
    albedo = mix(albedo, vec3(0.068, 0.064, 0.058), fieldPuddleMask * 0.50);
    groundN = normalize(mix(groundN, vec3(0.0, 1.0, 0.0), fieldPuddleMask * 0.52));

    float clodCrevice = 1.0 - smoothstep(0.18, 0.62, clodCell);
    float groundAo = 1.0 -
        clodCrevice * 0.24 * midFade -
        cobbleRim * 0.38 -
        soilCrackMask * 0.68 -
        meadowTurfMask * (1.0 - cloverFine) * 0.22;

    outAlbedo = albedo;
    outNormal = groundN;
    outRough = groundRough;
    outSpec = groundSpec;
    outAo = clamp(groundAo, 0.24, 1.0);
  }

  void EvaluateGardenPath(
    vec2 uv,
    vec3 N,
    vec3 T,
    vec3 B,
    float clodCell,
    float fineGrit,
    float fineFade,
    float midFade,
    out vec3 outAlbedo,
    out vec3 outNormal,
    out float outRough,
    out float outSpec,
    out float outAo
  ) {
    float edgeDist = abs(uv.x - 0.5) * 2.0;
    float vergeMix = smoothstep(0.60, 0.96, edgeDist);
    float rakeWave = sin(uv.x * 56.0 + fineGrit * 0.55 * fineFade);
    float rakeAmp = mix(0.25, 1.0, fineFade);

    vec3 gravelBed = mix(vec3(0.28, 0.23, 0.16), vec3(0.41, 0.34, 0.25), clodCell);
    gravelBed *= 0.90 + 0.10 * rakeWave * rakeAmp;
    vec3 mossyVerge = mix(vec3(0.062, 0.118, 0.040), vec3(0.135, 0.128, 0.082), clodCell * 0.48);

    outAlbedo = mix(gravelBed, mossyVerge, vergeMix);
    float rakeSlope = cos(uv.x * 56.0) * (1.0 - vergeMix) * 0.22 * rakeAmp;
    outNormal = normalize(
      N +
          T * (rakeSlope + fineGrit * 0.08 * fineFade) +
          B * ((clodCell - 0.5) * 0.18 * midFade)
    );
    outRough = mix(0.84, 0.93, vergeMix);
    outSpec = 0.38;

    float troughAo = (0.5 - 0.5 * rakeWave) * (1.0 - vergeMix) * 0.34 * rakeAmp;
    float pebbleAo = (1.0 - smoothstep(0.20, 0.65, clodCell)) * 0.24 * midFade;
    outAo = clamp(1.0 - troughAo - pebbleAo - vergeMix * 0.18, 0.36, 1.0);
  }

  void EvaluateKaidoRoad(
    vec3 P,
    vec2 uv,
    vec3 N,
    vec3 T,
    vec3 B,
    vec2 warp,
    vec3 baseRoadAlbedo,
    float clodCell,
    float fineGrit,
    float fineFade,
    float midFade,
    out vec3 outAlbedo,
    out vec3 outNormal,
    out float outRough,
    out float outSpec,
    out float outAo
  ) {
    float edgeDist = abs(uv.x - 0.5) * 2.0;
    float rutDist = abs(edgeDist - 0.42);
    float rutGouge = exp(-pow(rutDist * 7.5, 2.0));
    float rutPair = rutGouge;
    float rutSpill = exp(-pow((rutDist - 0.14) * 9.0, 2.0)) * 0.45;
    float shoulder = smoothstep(0.70, 0.98, edgeDist);
    float shoulderMix = shoulder;

    float scourMass = smoothstep(
      0.38,
      0.76,
      NoiseSimplex2(P.xz * 0.82 + warp * 0.16, 757) * 0.5 + 0.5 + rutSpill * 0.35
    );
    float cobbleDist = max(
      0.0,
      NoiseCellular2(P.xz * 5.6, 787, kNoiseCellularEuclidean, kNoiseCellularDistance, 0.88) + 1.0
    );
    float cobbleRadius = (0.20 + 0.20 * clodCell) * scourMass;
    float pebbleSpeck = (1.0 - smoothstep(cobbleRadius * 0.42, max(cobbleRadius, 0.04), cobbleDist)) *
        step(0.03, cobbleRadius) *
        mix(0.35, 1.0, fineFade);

    float rutSlope = (edgeDist - 0.42) * rutPair * (uv.x < 0.5 ? -0.44 : 0.44);
    float clodRelief = (clodCell - 0.5) * 0.24 * midFade;
    float pebbleRelief = pebbleSpeck * 0.28;
    float bermDisplacement = (rutSpill - rutPair * 0.24) * 0.30;

    vec3 soilNormalDelta = T * (rutSlope + fineGrit * 0.09 * fineFade) +
        B * (clodRelief + pebbleRelief + bermDisplacement);
    vec3 perturbedN = normalize(N + soilNormalDelta * 1.55);

    vec3 warmTerracotta = baseRoadAlbedo * vec3(1.22, 1.02, 0.78);
    vec3 coolDampUmber = baseRoadAlbedo * vec3(0.58, 0.50, 0.42);
    vec3 rutSoil = mix(
      warmTerracotta,
      coolDampUmber,
      clamp(rutPair * 0.82 + shoulderMix * 0.38, 0.0, 1.0)
    );
    vec3 embeddedStone = mix(vec3(0.18, 0.16, 0.15), vec3(0.30, 0.26, 0.22), clodCell);
    vec3 roadRgb = mix(rutSoil, embeddedStone, pebbleSpeck * 0.52);
    roadRgb = mix(roadRgb, vec3(0.076, 0.122, 0.044), shoulderMix * 0.46);

    float puddleNoise = NoiseSimplex2(P.xz * 1.15 + warp * 0.15, 853) * 0.5 + 0.5;
    float rutPuddleMask = smoothstep(0.42, 0.86, puddleNoise * rutPair) *
        smoothstep(0.82, 0.98, N.y);

    float roadRough = mix(mix(0.88, 0.68, rutGouge * 0.55), 0.24, rutPuddleMask);
    float spec = mix(0.42, 0.58, rutPuddleMask);
    roadRgb = mix(roadRgb, vec3(0.072, 0.064, 0.056), rutPuddleMask * 0.54);
    perturbedN = normalize(mix(perturbedN, vec3(0.0, 1.0, 0.0), rutPuddleMask * 0.54));

    float clodPocket = (1.0 - smoothstep(0.18, 0.64, clodCell)) * 0.24 * midFade;
    float roadAo = 1.0 -
        rutPair * 0.48 * (1.0 - rutPuddleMask * 0.55) -
        clodPocket -
        pebbleSpeck * 0.16 -
        shoulderMix * 0.14;

    outAlbedo = roadRgb;
    outNormal = perturbedN;
    outRough = roadRough;
    outSpec = spec;
    outAo = clamp(roadAo, 0.26, 1.0);
  }

  void Surface(inout MaterialInputs material) {
    vec3 P0 = GetWorldPosition();
    vec3 N = normalize(GetWorldNormal());
    vec2 uv0 = GetUV0();
    vec2 laneBlend = clamp(GetUV1(), 0.0, 1.0);
    vec4 vColor = GetVertexColor();
    float style = material_params.style_id;
    float animT = material_params.time_sec > 0.0001 ? material_params.time_sec : GetTime();

    vec3 dPdx = dFdx(P0);
    vec3 dPdy = dFdy(P0);
    vec2 dUVdx = dFdx(uv0);
    vec2 dUVdy = dFdy(uv0);
    float footprint = clamp(length(fwidth(P0)), 0.002, 1.5);
    float fineFade = 1.0 - smoothstep(0.035, 0.22, footprint);
    float midFade = 1.0 - smoothstep(0.10, 0.55, footprint);

    vec3 upRef = abs(N.y) < 0.92 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(upRef, N));
    vec3 B = normalize(cross(N, T));

    vec3 r1 = cross(dPdy, N);
    vec3 r2 = cross(N, dPdx);
    float det = dot(dPdx, r1);
    float invDet = abs(det) > 1e-8 ? (1.0 / det) : 0.0;

    float viewDist = length(v_viewvector);
    vec3 viewRay = viewDist > 1e-4 ? (v_viewvector / viewDist) : GetViewDirection();
    float parallaxFade = 1.0 - smoothstep(14.0, 52.0, viewDist);
    float baseReliefDepth = ReliefDepthForStyle(style, N, vColor);
    float activeReliefDepth = baseReliefDepth * parallaxFade;

    vec3 P = P0;
    vec2 uv = uv0;
    float hCenter = 1.0;

    if (activeReliefDepth > 0.001) {
      float cosVN = max(dot(viewRay, N), 0.30);
      vec2 fullOffsetTB = -vec2(dot(viewRay, T), dot(viewRay, B)) * (activeReliefDepth / cosVN);

      float prevLayer = 0.0;
      float prevMap = 1.0 - SampleReliefHeight(P0, uv0, N, T, B, vColor, style, laneBlend, midFade);
      float currLayer = 0.0;
      float currMap = prevMap;

      for (int stepIdx = 1; stepIdx <= 4; stepIdx++) {
        currLayer = float(stepIdx) * 0.25;
        vec2 stepTB = fullOffsetTB * currLayer;
        vec3 stepP = P0 + T * stepTB.x + B * stepTB.y;
        vec2 stepUv = uv0 + clamp(
          dUVdx * (dot(stepP - P0, r1) * invDet) + dUVdy * (dot(stepP - P0, r2) * invDet),
          vec2(-0.045),
          vec2(0.045)
        );
        currMap = 1.0 - SampleReliefHeight(stepP, stepUv, N, T, B, vColor, style, laneBlend, midFade);
        if (currMap <= currLayer) {
          break;
        }
        prevLayer = currLayer;
        prevMap = currMap;
      }

      float afterDiff = currLayer - currMap;
      float beforeDiff = prevMap - prevLayer;
      float hitWeight = clamp(beforeDiff / max(beforeDiff + afterDiff, 1e-4), 0.0, 1.0);
      float finalDepth = currMap <= currLayer ? mix(prevLayer, currLayer, hitWeight) : currMap;

      vec2 parallaxTB = fullOffsetTB * finalDepth;
      P = P0 + T * parallaxTB.x + B * parallaxTB.y;
      uv = uv0 + clamp(
        dUVdx * (dot(P - P0, r1) * invDet) + dUVdy * (dot(P - P0, r2) * invDet),
        vec2(-0.045),
        vec2(0.045)
      );
      hCenter = 1.0 - finalDepth;
    } else if (baseReliefDepth > 0.001) {
      hCenter = SampleReliefHeight(P0, uv0, N, T, B, vColor, style, laneBlend, midFade);
    }

    float horizonOcc = 1.0;
    if (baseReliefDepth > 0.004 && frag_info.has_directional_light > 0.5) {
      vec3 rawLightDir = frag_info.directional_light_direction.xyz;
      float rawLightLen2 = dot(rawLightDir, rawLightDir);
      vec3 sunVector = rawLightLen2 > 1e-6
          ? (-rawLightDir * inversesqrt(rawLightLen2))
          : normalize(vec3(-0.58, 0.46, -0.67));
      float sunDotN = dot(sunVector, N);
      if (sunDotN > 0.02) {
        vec2 sunTang = vec2(dot(sunVector, T), dot(sunVector, B));
        float sunTangLen = length(sunTang);
        vec2 sunDirTB = sunTangLen > 1e-4 ? (sunTang / sunTangLen) : vec2(1.0, 0.0);
        float tanElev = sunDotN / max(sunTangLen, 0.16);

        float d1 = 0.048;
        vec3 pSun1 = P + (T * sunDirTB.x + B * sunDirTB.y) * d1;
        vec2 uvSun1 = uv + clamp(
          dUVdx * (dot(pSun1 - P, r1) * invDet) + dUVdy * (dot(pSun1 - P, r2) * invDet),
          vec2(-0.04),
          vec2(0.04)
        );
        float hSun1 = SampleReliefHeight(pSun1, uvSun1, N, T, B, vColor, style, laneBlend, midFade);
        float block1 = max(0.0, (hSun1 - hCenter) * baseReliefDepth - d1 * tanElev * 0.40) /
            max(baseReliefDepth, 0.01);

        float d2 = 0.118;
        vec3 pSun2 = P + (T * sunDirTB.x + B * sunDirTB.y) * d2;
        vec2 uvSun2 = uv + clamp(
          dUVdx * (dot(pSun2 - P, r1) * invDet) + dUVdy * (dot(pSun2 - P, r2) * invDet),
          vec2(-0.06),
          vec2(0.06)
        );
        float hSun2 = SampleReliefHeight(pSun2, uvSun2, N, T, B, vColor, style, laneBlend, midFade);
        float block2 = max(0.0, (hSun2 - hCenter) * baseReliefDepth - d2 * tanElev * 0.40) /
            max(baseReliefDepth, 0.01);

        float horizonBlock = clamp(max(block1 * 1.48, block2 * 1.15), 0.0, 1.0);
        horizonOcc = 1.0 - 0.56 * smoothstep(0.03, 0.52, horizonBlock) * mix(0.45, 1.0, midFade);
      } else {
        horizonOcc = 0.72;
      }
    }

    float pigmentFbm = NoiseFbm3(
      P * (material_params.grain_scale * 0.24),
      1337,
      3,
      2.0,
      0.5
    );
    float pigment = clamp(0.5 + 0.5 * pigmentFbm, 0.0, 1.0);
    float microBrush = mix(0.5, NoiseSimplex3(P * 9.5, 811) * 0.5 + 0.5, fineFade);
    float pigmentMix = clamp(pigment * 0.52 + (microBrush - 0.5) * 0.16, 0.0, 1.0);

    vec3 albedo = mix(
      material_params.base_tint.rgb,
      material_params.warm_tint.rgb,
      pigmentMix
    );
    float rough = material_params.roughness_val + (pigment - 0.5) * 0.10;
    float spec = 0.42;
    float cavityAo = 0.92;
    vec3 perturbedN = N;
    float laneFeatherForTint = 0.0;

    if (abs(style - kStyleKawaraTile) < 0.5) {
      float uEave = dot(P, T);
      float vSlope = dot(P, B);
      if (vColor.a <= 0.45) {
        float reedWarp = NoiseSimplex3(P * 3.4, 331) * 0.65;
        float reedBundle = mix(0.5, sin(uEave * 44.0 + reedWarp * 2.4) * 0.5 + 0.5, midFade);
        float reedFine = mix(
          0.5,
          NoiseSimplex2(vec2(uEave * 26.0, vSlope * 5.5), 337) * 0.5 + 0.5,
          fineFade
        );
        float layerFract = fract(vSlope / 0.46 + reedWarp * 0.12);
        float layerLip = 1.0 - smoothstep(0.0, 0.18, layerFract);
        float layerShadow = 1.0 - 0.30 * layerLip;
        vec3 thatchDark = vec3(0.46, 0.35, 0.17);
        vec3 thatchGold = vec3(0.78, 0.62, 0.32);
        albedo = mix(thatchDark, thatchGold, clamp(reedBundle * 0.48 + reedFine * 0.52, 0.0, 1.0));
        albedo *= layerShadow * (0.88 + 0.22 * pigment);
        float thatchMoss = smoothstep(0.50, 0.82, pigment * 0.68 + reedFine * 0.32) *
            material_params.weathering;
        albedo = mix(albedo, vec3(0.11, 0.19, 0.065), thatchMoss * 0.65);
        float reedSlope = cos(uEave * 44.0 + reedWarp * 2.4) * 0.24 * midFade;
        float stepKick = (1.0 - smoothstep(0.0, 0.16, layerFract)) * 0.30;
        perturbedN = normalize(N + T * reedSlope + B * (stepKick + (reedFine - 0.5) * 0.12));
        rough = clamp(0.89 + (reedFine - 0.5) * 0.08, 0.82, 0.95);
        spec = 0.24;
        cavityAo = clamp(
          (1.0 - 0.56 * layerLip) * (0.72 + 0.28 * reedBundle),
          0.26,
          1.0
        );
      } else if (vColor.a <= 0.85) {
        float shakeRow = floor(vSlope / 0.28);
        float shakeU = uEave / 0.15 + mod(shakeRow, 2.0) * 0.43;
        float shakeCol = floor(shakeU);
        float shakeFx = fract(shakeU);
        float shakeFy = fract(vSlope / 0.28);
        float shakeSeam = (1.0 - smoothstep(0.0, 0.11, min(shakeFx, 1.0 - shakeFx))) * midFade;
        float courseUnder = 1.0 - smoothstep(0.0, 0.15, shakeFy);
        float courseShadow = 1.0 - 0.38 * courseUnder;
        float shakeVar = NoiseValue2(vec2(shakeCol * 1.3, shakeRow * 1.7), 347) * 0.5 + 0.5;
        float woodFiber = mix(
          0.5,
          NoiseSimplex2(vec2(uEave * 18.0, vSlope * 6.2), 353) * 0.5 + 0.5,
          fineFade
        );
        vec3 cedarUmber = vec3(0.22, 0.14, 0.082);
        vec3 cedarWarm = vec3(0.44, 0.28, 0.16);
        albedo = mix(cedarUmber, cedarWarm, clamp(shakeVar * 0.62 + woodFiber * 0.38, 0.0, 1.0));
        albedo *= courseShadow * (1.0 - 0.44 * shakeSeam) * (0.90 + 0.20 * pigment);
        float shakeMoss = smoothstep(0.56, 0.85, pigment * 0.65 + shakeVar * 0.35) *
            material_params.weathering;
        albedo = mix(albedo, vec3(0.088, 0.15, 0.052), shakeMoss * 0.60);
        float seamBevel = (shakeFx < 0.11 ? -1.0 : (shakeFx > 0.89 ? 1.0 : 0.0)) * shakeSeam;
        float stepKick = (1.0 - smoothstep(0.0, 0.12, shakeFy)) * 0.34;
        perturbedN = normalize(
          N + T * (seamBevel * 0.30 + (woodFiber - 0.5) * 0.10) + B * stepKick
        );
        rough = clamp(0.80 + shakeSeam * 0.10 - woodFiber * 0.06, 0.68, 0.93);
        spec = 0.34;
        cavityAo = clamp((1.0 - 0.58 * courseUnder) * (1.0 - 0.56 * shakeSeam), 0.24, 1.0);
      } else if (abs(N.y) < 0.95) {
        float ribPhase = uEave * (6.2831853 / 0.26);
        float ribWave = cos(ribPhase);
        float ribSlope = -sin(ribPhase) * mix(0.45, 1.0, midFade);

        float courseFract = fract(vSlope / 0.34);
        float courseLip = smoothstep(0.0, 0.11, courseFract) *
            (1.0 - smoothstep(0.88, 1.0, courseFract));
        float courseUnder = 1.0 - smoothstep(0.0, 0.15, courseFract);
        float overlapShadow = 1.0 - 0.36 * courseUnder;

        float tileVar = NoiseValue2(
          vec2(floor(uEave / 0.26), floor(vSlope / 0.34)),
          313
        ) * 0.5 + 0.5;
        float mossMask = smoothstep(0.60, 0.86, pigment * 0.65 + tileVar * 0.35) *
            material_params.weathering;

        float crownLight = 0.74 + 0.36 * (ribWave * 0.5 + 0.5);
        vec3 warmFired = albedo * vec3(1.24, 1.06, 0.94);
        albedo = mix(albedo, warmFired, smoothstep(0.55, 0.92, tileVar) * 0.46);
        albedo *= crownLight * overlapShadow * (0.88 + 0.24 * tileVar);
        albedo = mix(albedo, vec3(0.072, 0.125, 0.050), mossMask * 0.58);

        float stepKick = (1.0 - smoothstep(0.0, 0.11, courseFract)) * 0.36;
        perturbedN = normalize(
          N + T * (ribSlope * 0.38) + B * (stepKick * (courseLip * 0.2 + 0.8))
        );
        rough = mix(0.35, 0.79, (1.0 - (ribWave * 0.5 + 0.5)) * 0.70 + mossMask * 0.30);
        spec = 0.64;
        cavityAo = clamp(
          (1.0 - 0.58 * courseUnder) * (0.64 + 0.36 * (ribWave * 0.5 + 0.5)),
          0.24,
          1.0
        );
      } else {
        cavityAo = 0.86;
      }
    } else if (abs(style - kStyleCedarTimber) <= 0.5) {
      float boardCoord = abs(N.y) < 0.55 ? dot(P, T) / 0.21 : dot(P, T) / 0.24;
      float grainCoord = abs(N.y) < 0.55 ? P.y * 2.2 : dot(P, B) * 1.8;
      float boardFract = fract(boardCoord);
      float boardId = floor(boardCoord);
      float seam = (1.0 - smoothstep(0.0, 0.09, min(boardFract, 1.0 - boardFract))) * midFade;
      float boardTone = NoiseValue2(vec2(boardId, floor(grainCoord * 0.2)), 401) * 0.5 + 0.5;
      float woodGrain = mix(
        0.5,
        NoiseSimplex2(vec2(boardCoord * 3.5, grainCoord * 4.8), 419) * 0.5 + 0.5,
        fineFade
      );

      albedo *= (0.82 + 0.34 * boardTone) * (0.88 + 0.22 * woodGrain) * (1.0 - 0.44 * seam);
      float bevel = (boardFract < 0.09 ? -1.0 : (boardFract > 0.91 ? 1.0 : 0.0)) * seam;
      perturbedN = normalize(N + T * (bevel * 0.30 + (woodGrain - 0.5) * 0.09));
      rough = clamp(rough + seam * 0.12 - woodGrain * 0.06, 0.35, 0.96);
      cavityAo = clamp((1.0 - 0.68 * seam) * (0.88 + 0.12 * woodGrain), 0.25, 1.0);
    } else if (abs(style - kStyleStoneMasonry) < 0.5) {
      bool isCutMasonry = vColor.a > 0.75;
      if (isCutMasonry) {
        float uStone = dot(P, T);
        float vStone = abs(N.y) < 0.82 ? P.y : dot(P, B);
        float row = floor(vStone / 0.44);
        float wobble = NoiseSimplex2(vec2(uStone * 0.9, vStone * 0.9), 509) * 0.14;
        float colCoord = (uStone + wobble) / 0.66 + mod(row, 2.0) * 0.47;
        float rowCoord = (vStone + wobble * 0.6) / 0.44;
        float fx = fract(colCoord);
        float fy = fract(rowCoord);
        float col = floor(colCoord);

        float edgeX = min(fx, 1.0 - fx);
        float edgeY = min(fy, 1.0 - fy);
        float mortar = 1.0 - smoothstep(0.02, 0.11, min(edgeX, edgeY * 0.85));
        mortar *= mix(0.45, 1.0, midFade);
        float stoneHash = NoiseValue2(vec2(col * 1.3, row * 1.7), 521) * 0.5 + 0.5;
        float rockFacet = NoiseSimplex3(P * 2.6, 547) * midFade;
        float rockPore = NoiseSimplex3(P * 9.4, 557) * fineFade;

        vec3 warmGranite = albedo * vec3(1.24, 1.08, 0.90);
        vec3 coolSlate = albedo * vec3(0.78, 0.90, 1.10);
        albedo = mix(coolSlate, warmGranite, stoneHash);
        albedo *= (0.86 + 0.24 * (rockFacet * 0.5 + 0.5) + 0.06 * rockPore) *
            (1.0 - 0.58 * mortar);

        float dampMoss = smoothstep(0.48, -0.36, P.y) * 0.58 +
            smoothstep(0.56, 0.84, pigment) * material_params.weathering * 0.68;
        albedo = mix(
          albedo,
          vec3(0.058, 0.122, 0.044),
          clamp(dampMoss * (0.46 + 0.54 * mortar), 0.0, 0.74)
        );

        float bevelX = (fx < 0.13 ? -1.0 : (fx > 0.87 ? 1.0 : 0.0)) *
            (1.0 - smoothstep(0.0, 0.13, edgeX)) *
            midFade;
        float bevelY = (fy < 0.15 ? -1.0 : (fy > 0.85 ? 1.0 : 0.0)) *
            (1.0 - smoothstep(0.0, 0.15, edgeY)) *
            midFade;
        perturbedN = normalize(
          N +
              T * (bevelX * 0.42 + rockFacet * 0.12 + rockPore * 0.05) +
              B * (bevelY * 0.38)
        );
        rough = mix(0.68, 0.95, mortar * 0.70 + dampMoss * 0.30);
        cavityAo = clamp((1.0 - 0.76 * mortar) * (0.86 + 0.14 * stoneHash), 0.22, 1.0);
      } else {
        float strataFbm = NoiseFbm3(vec3(P.x * 0.85, P.y * 1.15, P.z * 0.85), 563, 3, 2.0, 0.5);
        float rockWarp = NoiseSimplex3(P * 0.95 + vec3(3.7, -2.1, 1.9), 569);
        vec3 rockP = P * 1.58 + vec3(strataFbm * 0.64, rockWarp * 0.48, -strataFbm * 0.56);

        float cellDist = NoiseCellular3(
          rockP,
          571,
          kNoiseCellularEuclidean,
          kNoiseCellularDistance2Sub,
          0.94
        );
        float cellFine = NoiseCellular3(
          rockP * 2.15 + vec3(2.4, -1.7, 1.1),
          587,
          kNoiseCellularEuclidean,
          kNoiseCellularDistance2Sub,
          0.92
        );
        float crackRegion = smoothstep(0.22, 0.68, strataFbm * 0.5 + 0.52);
        float crackBreaker = smoothstep(0.24, 0.70, NoiseSimplex3(rockP * 2.4, 599) * 0.5 + 0.5);
        float crackDist = max(0.0, cellDist + 1.0);
        float fineCrackDist = max(0.0, cellFine + 1.0);
        float fissureMask = clamp(
          (1.0 - smoothstep(0.015, 0.13, crackDist)) * (0.45 + 0.55 * crackRegion) +
              (1.0 - smoothstep(0.01, 0.08, fineCrackDist)) * 0.48 * crackBreaker * fineFade,
          0.0,
          1.0
        );

        float strata = strataFbm;
        float shelfCoord = (P.y * 0.76 + P.x * 0.24 - P.z * 0.19) +
            strataFbm * 0.84 +
            rockWarp * 0.46;
        float shelfFract = fract(shelfCoord);
        float bedPlane = shelfFract;
        float bedCrevice = 1.0 - smoothstep(0.0, 0.16, bedPlane);
        float shelfRiser = smoothstep(0.76, 0.98, shelfFract);
        float shelfLedge = 1.0 - smoothstep(0.0, 0.14, abs(shelfFract - 0.76));

        float totalCrevice = clamp(fissureMask * 0.75 + shelfRiser * 0.55, 0.0, 1.0);

        float facetGrain = NoiseSimplex3(rockP * 1.85, 577) * midFade;
        float facetMicro = NoiseSimplex3(P * 7.8, 593) * fineFade;

        float fissureKickT = (NoiseSimplex3(rockP + vec3(0.32, 0.0, 0.0), 571) - 0.5) * fissureMask;
        float fissureKickB = (NoiseSimplex3(rockP + vec3(0.0, 0.32, 0.0), 573) - 0.5) * fissureMask;
        float shelfNormY = (shelfRiser * 2.0 - 1.0) * 0.28 + strata * 0.08;

        vec3 normalDelta = T * (fissureKickT * 0.46 + facetGrain * 0.18) +
            B * (shelfNormY + strataFbm * 0.18 + facetMicro * 0.09 + fissureKickB * 0.24);
        perturbedN = normalize(N + normalDelta * 1.45);

        float crownSun = clamp(N.y * 0.68 + 0.32, 0.0, 1.0);
        vec3 slateBelly = albedo * vec3(0.68, 0.78, 0.98);
        vec3 ochreCrown = albedo * vec3(1.56, 1.26, 0.86);
        albedo = mix(slateBelly, ochreCrown, crownSun * (0.60 + 0.40 * (strataFbm * 0.5 + 0.5)));
        albedo *= (0.88 + 0.24 * (facetGrain * 0.5 + 0.5)) * (1.0 - bedCrevice * 0.18);

        vec3 deepIndigoUmber = vec3(0.038, 0.032, 0.048);
        albedo = mix(albedo, deepIndigoUmber, totalCrevice * 0.68);

        float mossNoise = NoiseSimplex3(P * 2.4 + vec3(strataFbm * 0.4), 883) * 0.5 + 0.5;
        float mossPocket = smoothstep(0.42, 0.74, mossNoise) *
            smoothstep(0.16, 0.86, crownSun) *
            (1.0 - fissureMask * 0.60) *
            (0.44 + 0.56 * shelfLedge) *
            material_params.weathering;
        vec3 oliveMoss = vec3(0.076, 0.142, 0.046);
        albedo = mix(albedo, oliveMoss, clamp(mossPocket * 0.82, 0.0, 0.76));

        rough = mix(0.86, 0.52, totalCrevice * 0.60);
        rough = mix(rough, 0.94, mossPocket * 0.50);

        float riverDamp = smoothstep(-0.12, -0.58, P.y);
        rough = mix(rough, 0.34, riverDamp * 0.86);
        albedo = mix(albedo, albedo * 0.68, riverDamp * 0.44);
        cavityAo = clamp((1.0 - totalCrevice * 0.78) * (1.0 - bedCrevice * 0.22), 0.22, 1.0);
      }
    } else if (abs(style - kStyleEdoPlaster) <= 0.5) {
      float trowel = NoiseSimplex3(vec3(P.x * 2.8, P.y * 4.6, P.z * 2.8), 601) * midFade;
      float fineGrain = NoiseSimplex3(P * 11.0, 613) * fineFade;
      float splashMask = clamp(1.0 - uv.y * 2.8, 0.0, 1.0) * material_params.weathering;
      albedo *= 0.94 + 0.10 * trowel + 0.04 * fineGrain;
      albedo = mix(albedo, albedo * vec3(0.54, 0.48, 0.42), splashMask * 0.68);
      perturbedN = normalize(N + T * (trowel * 0.07 + fineGrain * 0.03));
      cavityAo = clamp(0.94 - splashMask * 0.22 - max(0.0, -trowel) * 0.12, 0.62, 1.0);
    } else if (style > 4.5 && style < 5.8) {
      float isLane = step(kStyleLaneThreshold, style);
      vec2 warp = vec2(
        NoiseSimplex2(P.xz * 0.10, 683),
        NoiseSimplex2(P.xz * 0.10, 691)
      ) * 2.9;

      float clodCell = mix(
        0.5,
        NoiseCellular2(
          P.xz * 3.8,
          719,
          kNoiseCellularEuclidean,
          kNoiseCellularCellValue,
          0.75
        ) * 0.5 + 0.5,
        midFade
      );
      float fineGrit = NoiseSimplex2(P.xz * 9.2, 733) * fineFade;

      if (isLane > 0.5) {
        bool isGardenPath = vColor.a < 0.60;
        float breakupNoise = NoiseSimplex2(P.xz * 2.8, 947);
        float breakupFine = NoiseSimplex2(P.xz * 6.4, 953) * fineFade;
        float junctionEnvelope = 4.0 * laneBlend.y * (1.0 - laneBlend.y);
        float roadMix = isGardenPath
            ? smoothstep(0.0, 1.0, clamp(laneBlend.y + breakupNoise * 0.18 * junctionEnvelope, 0.0, 1.0))
            : 1.0;

        vec3 laneAlbedo;
        vec3 laneN;
        float laneRough;
        float laneSpec;
        float laneAo;

        if (roadMix <= 0.001) {
          EvaluateGardenPath(
            uv, N, T, B, clodCell, fineGrit, fineFade, midFade,
            laneAlbedo, laneN, laneRough, laneSpec, laneAo
          );
        } else if (roadMix >= 0.999) {
          EvaluateKaidoRoad(
            P, uv, N, T, B, warp, albedo, clodCell, fineGrit, fineFade, midFade,
            laneAlbedo, laneN, laneRough, laneSpec, laneAo
          );
        } else {
          vec3 gAlb;
          vec3 gN;
          float gRough;
          float gSpec;
          float gAo;
          EvaluateGardenPath(
            uv, N, T, B, clodCell, fineGrit, fineFade, midFade,
            gAlb, gN, gRough, gSpec, gAo
          );
          vec3 kAlb;
          vec3 kN;
          float kRough;
          float kSpec;
          float kAo;
          EvaluateKaidoRoad(
            P, uv, N, T, B, warp, albedo, clodCell, fineGrit, fineFade, midFade,
            kAlb, kN, kRough, kSpec, kAo
          );
          laneAlbedo = mix(gAlb, kAlb, roadMix);
          laneN = normalize(mix(gN, kN, roadMix));
          laneRough = mix(gRough, kRough, roadMix);
          laneSpec = mix(gSpec, kSpec, roadMix);
          laneAo = mix(gAo, kAo, roadMix);
        }

        float featherEnvelope = 4.0 * laneBlend.x * (1.0 - laneBlend.x);
        float organicBreakup = (breakupNoise * 0.72 + breakupFine * 0.28) * featherEnvelope;
        float featherMask = smoothstep(
          0.0,
          1.0,
          clamp(laneBlend.x + organicBreakup * 0.34, 0.0, 1.0)
        );
        laneFeatherForTint = featherMask;

        if (featherMask > 0.001) {
          vec3 naturalSoilTint = albedo * vec3(0.58, 0.62, 0.66);
          vec3 gndAlb;
          vec3 gndN;
          float gndRough;
          float gndSpec;
          float gndAo;
          float edgeWear = mix(0.58, 0.32, featherMask);
          EvaluateNaturalGround(
            P, N, warp, naturalSoilTint, edgeWear, clodCell, fineGrit, fineFade, midFade,
            gndAlb, gndN, gndRough, gndSpec, gndAo
          );
          albedo = mix(laneAlbedo, gndAlb, featherMask);
          perturbedN = normalize(mix(laneN, gndN, featherMask));
          rough = mix(laneRough, gndRough, featherMask);
          spec = mix(laneSpec, gndSpec, featherMask);
          cavityAo = mix(laneAo, gndAo, featherMask);
        } else {
          albedo = laneAlbedo;
          perturbedN = laneN;
          rough = laneRough;
          spec = laneSpec;
          cavityAo = laneAo;
        }
      } else {
        float wear = clamp(vColor.a, 0.0, 1.0);
        EvaluateNaturalGround(
          P, N, warp, albedo, wear, clodCell, fineGrit, fineFade, midFade,
          albedo, perturbedN, rough, spec, cavityAo
        );
      }
    } else if (style >= 5.8) {
      if (abs(style - kStyleDyedCloth) < 0.25) {
        if (vColor.a < 0.75) {
          albedo = mix(vec3(0.82, 0.79, 0.74), vec3(0.96, 0.93, 0.88), pigment);
        }
        float stripe = sin(uv.x * 37.699) * 0.5 + 0.5;
        float weave = NoiseSimplex2(uv * 48.0, 809) * 0.08 * fineFade;
        albedo *= 0.88 + 0.22 * smoothstep(0.35, 0.65, stripe) + weave;
        cavityAo = clamp(0.84 + 0.16 * stripe, 0.72, 1.0);
      } else {
        rough = 0.42;
        spec = 0.68;
        cavityAo = 0.92;
      }
    }

    float goboLight = ComputeAtmosphericGobo(P0.xz, animT);
    float goboStrength = (style > 4.5 && style < 5.8) ? 1.0 : 0.62;
    vec3 goboTint = mix(
      vec3(1.0),
      mix(vec3(0.78, 0.85, 0.96), vec3(1.13, 1.06, 0.96), goboLight),
      goboStrength
    );
    albedo *= goboTint;
    albedo *= mix(vec3(0.76, 0.81, 0.90), vec3(1.0), horizonOcc);

    float wallDripMask = smoothstep(0.88, 0.42, abs(N.y));
    float dripNoise = NoiseSimplex2(vec2(P.x * 1.4 + P.z * 1.4, P.y * 2.6), 42);
    float drip = clamp(0.5 + 0.5 * dripNoise, 0.0, 1.0) * material_params.weathering * wallDripMask;
    vec3 weathered = mix(albedo, albedo * 0.74, drip * 0.34);

    float upMoisture = smoothstep(0.35, 0.92, perturbedN.y) * material_params.dew_sheen;
    float baseDewHold = (style > 0.5 && style < 3.5) || style > kStyleLaneThreshold
        ? 0.44
        : (style > 4.5 ? 0.06 : 0.18);
    float dewHold = style > kStyleLaneThreshold && style < 5.8
        ? mix(baseDewHold, 0.06, laneFeatherForTint)
        : baseDewHold;
    float moistureMix = upMoisture * dewHold;
    rough = mix(rough, min(rough, 0.42), moistureMix);
    spec = mix(spec, max(spec, 0.54), moistureMix);

    vec3 effectiveVColor = style > kStyleLaneThreshold && style < 5.8
        ? mix(vColor.rgb, vec3(0.95, 0.90, 0.80), laneFeatherForTint)
        : vColor.rgb;

    float goboAo = mix(1.0, mix(0.84, 1.0, goboLight), goboStrength * 0.75);
    float finalOcclusion = clamp(
      cavityAo * horizonOcc * goboAo * (1.0 - drip * 0.18),
      0.22,
      1.0
    );

    material.base_color = vec4(weathered * effectiveVColor, 1.0);
    material.normal = perturbedN;
    material.metallic = 0.0;
    material.roughness = clamp(rough, 0.08, 0.94);
    material.specular = spec;
    material.occlusion = finalOcclusion;

    PrepareMaterial(material);
  }
}
