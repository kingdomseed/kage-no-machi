material {
  name: "FoliageCanopy",
  shading_model: lit,
  blending: opaque,
  culling: none,
  parameters: [
    { type: vec4, name: leaf_primary, hint: source_color, default: [0.82, 0.22, 0.14, 1.0] },
    { type: vec4, name: leaf_secondary, hint: source_color, default: [0.94, 0.52, 0.18, 1.0] },
    { type: float, name: rim_warmth, default: 0.35 },
    { type: float, name: wind_strength, default: 0.18 },
    { type: float, name: time_sec, default: 0.0 }
  ]
}

vertex {
  void Vertex(inout VertexInputs vertex) {
    float t = material_params.time_sec;
    float heightWeight = clamp(vertex.position.y * 0.35, 0.0, 2.5);
    float swayX = sin(t * 1.8 + vertex.world_position.x * 0.6 + vertex.world_position.z * 0.4);
    float swayZ = cos(t * 1.4 + vertex.world_position.x * 0.3 + vertex.world_position.z * 0.7);
    vertex.world_position.x += swayX * material_params.wind_strength * heightWeight * 0.2;
    vertex.world_position.z += swayZ * material_params.wind_strength * heightWeight * 0.15;
  }
}

fragment {
  #include <noise.glsl>

  void Surface(inout MaterialInputs material) {
    vec3 worldPos = GetWorldPosition();
    float clusterNoise = NoiseFbm3(worldPos * 1.4, 77, 3, 2.0, 0.5);
    float cluster = clamp(0.5 + 0.5 * clusterNoise, 0.0, 1.0);

    vec3 leafColor = mix(
      material_params.leaf_primary.rgb,
      material_params.leaf_secondary.rgb,
      cluster
    );

    vec3 normal = GetWorldNormal();
    vec3 viewDir = GetViewDirection();
    float rim = pow(clamp(1.0 - abs(dot(normal, viewDir)), 0.0, 1.0), 2.2);
    leafColor += material_params.leaf_secondary.rgb * (rim * material_params.rim_warmth);

    vec4 vColor = GetVertexColor();
    material.base_color = vec4(
      leafColor * vColor.rgb,
      material_params.leaf_primary.a * vColor.a
    );
    material.metallic = 0.0;
    material.roughness = 0.82;

    PrepareMaterial(material);
  }
}
