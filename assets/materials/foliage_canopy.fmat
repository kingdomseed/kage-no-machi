material {
  name: "FoliageCanopy",
  shading_model: lit,
  blending: opaque,
  alpha_to_coverage: true,
  culling: none,
  parameters: [
    { type: vec4, name: leaf_primary, hint: source_color, default: [0.82, 0.22, 0.14, 1.0] },
    { type: vec4, name: leaf_secondary, hint: source_color, default: [0.94, 0.52, 0.18, 1.0] },
    { type: float, name: rim_warmth, default: 0.45 },
    { type: float, name: sun_translucency, default: 1.0 },
    { type: float, name: wind_strength, default: 0.16 },
    { type: float, name: foliage_kind, default: 0.0 },
    { type: float, name: time_sec, default: 0.0 }
  ]
}

vertex {
  void Vertex(inout VertexInputs vertex) {
    float t = material_params.time_sec;
    float kind = material_params.foliage_kind;
    vec3 wp = vertex.world_position;
    float h = max(0.0, vertex.position.y);

    float cantilever;
    if (kind > 3.5) {
      float hang = max(0.0, -vertex.position.y);
      cantilever = pow(clamp(hang * 0.48, 0.0, 1.35), 1.55) * 2.15;
    } else if (kind > 2.5) {
      cantilever = clamp(h * h * 0.024, 0.0, 0.95);
    } else if (kind < 1.5) {
      cantilever = clamp(h * h * 0.046, 0.0, 1.85);
    } else {
      cantilever = smoothstep(0.04, 0.85, h) * 1.22;
    }

    const vec2 windDir = vec2(0.7808688, 0.6246950);
    const vec2 crossDir = vec2(-0.6246950, 0.7808688);
    float phase = sin(wp.x * 0.21 + wp.z * 0.14) * 1.6
      + cos(wp.z * 0.18 - wp.x * 0.12) * 1.4;
    float slowBreath = 0.5 + 0.5 * sin(t * 0.68 + phase);
    float gentleSway = sin(t * 1.08 - phase * 0.7 + wp.y * 0.35);

    float push = (0.04 + 0.18 * slowBreath + 0.05 * gentleSway)
      * material_params.wind_strength
      * cantilever;
    vec2 dispXZ = windDir * push
      + crossDir * (gentleSway * 0.06 * material_params.wind_strength * cantilever);
    wp.xz += dispXZ;
    if (kind > 3.5) {
      wp.y += min(0.06, dot(dispXZ, dispXZ) * 0.35);
    }
    vertex.world_position = wp;
  }
}

fragment {
  #include <noise.glsl>

  float MapleLeaflet(vec2 p, float r, float rot) {
    float dist = length(p);
    if (dist > r * 1.38) {
      return 0.0;
    }
    float ang = atan(p.y, p.x) + rot;
    float palmate = 0.64 + 0.34 * abs(cos(ang * 2.5)) + 0.06 * cos(ang * 15.0);
    float wrapped = mod(ang + 3.14159265, 6.2831853) - 3.14159265;
    float stemNotch = 1.0 - 0.30 * exp(-wrapped * wrapped * 4.5);
    float targetR = r * palmate * stemNotch;
    return 1.0 - smoothstep(targetR * 0.72, targetR * 1.05, dist);
  }

  float MapleSprayCoverage(vec2 uv, float seed, out float leafTone) {
    float alpha = 0.0;
    float toneAcc = 0.35;
    const vec2 centers[9] = vec2[9](
      vec2(0.50, 0.52),
      vec2(0.30, 0.44),
      vec2(0.70, 0.45),
      vec2(0.36, 0.68),
      vec2(0.64, 0.69),
      vec2(0.50, 0.77),
      vec2(0.24, 0.60),
      vec2(0.76, 0.61),
      vec2(0.50, 0.28)
    );
    const float radii[9] = float[9](
      0.21, 0.18, 0.18, 0.19, 0.19, 0.17, 0.15, 0.15, 0.17
    );
    for (int i = 0; i < 9; i++) {
      float fi = float(i);
      vec2 jitter = vec2(
        0.035 * sin(seed * 1.7 + fi * 2.3),
        0.035 * cos(seed * 1.3 + fi * 3.1)
      );
      float rot = seed + fi * 1.15;
      float m = MapleLeaflet(uv - (centers[i] + jitter), radii[i], rot);
      if (m > alpha) {
        alpha = m;
        toneAcc = fract(sin(fi * 12.7 + seed * 0.8) * 43.7) * 0.65 + uv.y * 0.35;
      }
    }
    leafTone = clamp(toneAcc, 0.0, 1.0);
    return alpha;
  }

  float BambooLance(vec2 p, float angle, float len, float wid) {
    vec2 dir = vec2(cos(angle), sin(angle));
    vec2 perp = vec2(-dir.y, dir.x);
    float along = dot(p, dir);
    if (along < -0.01 || along > len * 1.04) {
      return 0.0;
    }
    float t = clamp(along / len, 0.0, 1.0);
    float arch = -0.09 * len * t * t * sign(dir.x + 0.04);
    float halfW = sin(pow(t, 0.60) * 3.14159265) * wid * (1.0 - 0.28 * t);
    float across = abs(dot(p, perp) - arch);
    return 1.0 - smoothstep(halfW * 0.45, halfW * 1.05, across);
  }

  float BambooSprayCoverage(vec2 uv, float seed, out float leafTone) {
    float alpha = 0.0;
    float toneAcc = 0.4;
    vec2 lowerNode = vec2(0.50, 0.10);
    vec2 upperNode = vec2(0.50, 0.34);
    for (int i = 0; i < 7; i++) {
      float fi = float(i);
      float frac = (fi - 3.0) / 3.0;
      float ang = 1.5707963 + frac * 1.06 + 0.05 * sin(seed + fi * 2.1);
      float len = 0.56 - 0.10 * abs(frac);
      float m = BambooLance(uv - lowerNode, ang, len, 0.062);
      if (m > alpha) {
        alpha = m;
        toneAcc = 0.25 + 0.55 * (0.5 + 0.5 * frac) + 0.20 * uv.y;
      }
    }
    for (int j = 0; j < 5; j++) {
      float fj = float(j);
      float frac = (fj - 2.0) / 2.0;
      float ang = 1.5707963 + frac * 0.78 + 0.05 * cos(seed * 1.3 + fj * 1.9);
      float len = 0.54 - 0.08 * abs(frac);
      float m = BambooLance(uv - upperNode, ang, len, 0.058);
      if (m > alpha) {
        alpha = m;
        toneAcc = 0.45 + 0.55 * uv.y;
      }
    }
    leafTone = clamp(toneAcc, 0.0, 1.0);
    return alpha;
  }

  float MeadowTuftCoverage(vec2 uv, float seed, out float leafTone) {
    if (uv.y >= 1.5) {
      vec2 luv = vec2(uv.x, uv.y - 2.0);
      float alpha = 0.0;
      float toneAcc = 0.5;
      const vec2 leafPts[5] = vec2[5](
        vec2(0.48, 0.50),
        vec2(0.27, 0.36),
        vec2(0.72, 0.40),
        vec2(0.35, 0.70),
        vec2(0.67, 0.68)
      );
      for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float m = MapleLeaflet(luv - leafPts[i], 0.165, seed + fi * 1.6);
        if (m > alpha) {
          alpha = m;
          toneAcc = 0.30 + 0.70 * fract(sin(fi * 9.1 + seed) * 31.7);
        }
      }
      leafTone = toneAcc;
      return alpha;
    }

    float alpha = 0.0;
    float bladeTip = uv.y;
    for (int i = 0; i < 8; i++) {
      float fi = float(i);
      float x0 = 0.14 + (fi / 7.0) * 0.72;
      float h = 0.58 + 0.35 * fract(sin(fi * 19.3 + seed) * 437.5);
      if (uv.y <= h) {
        float t = max(0.0, uv.y / h);
        float splay = (x0 - 0.5) * 0.30 + 0.07 * sin(fi * 4.3 + seed);
        float curveX = x0 + splay * t * t;
        float halfW = (0.048 - 0.008 * fract(fi * 0.37)) * (1.0 - pow(t, 1.35));
        float m = 1.0 - smoothstep(halfW * 0.42, halfW * 1.06, abs(uv.x - curveX));
        if (m > alpha) {
          alpha = m;
          bladeTip = t;
        }
      }
    }
    leafTone = 0.12 + 0.88 * clamp(bladeTip, 0.0, 1.0);
    return alpha;
  }

  float PineNeedleFan(vec2 p, float baseAng, float radius, float seed) {
    float r = length(p);
    if (r > radius * 1.06) {
      return 0.0;
    }
    float core = 1.0 - smoothstep(radius * 0.14, radius * 0.28, r);
    float ang = atan(p.y, p.x) - baseAng;
    float wrapped = mod(ang + 3.14159265, 6.2831853) - 3.14159265;
    if (abs(wrapped) > 1.52) {
      return core;
    }
    float rays = abs(cos(wrapped * 9.5 + 0.35 * sin(seed * 3.7 + r * 8.0)));
    float reach = radius * (0.36 + 0.64 * pow(rays, 1.35)) * (1.0 - 0.16 * abs(wrapped));
    float needle = (1.0 - smoothstep(reach * 0.74, reach, r)) * smoothstep(0.04, 0.14, r);
    return max(core, needle);
  }

  float PineSprayCoverage(vec2 uv, float seed, out float leafTone) {
    float alpha = 0.0;
    float toneAcc = 0.35;
    const vec2 hubs[5] = vec2[5](
      vec2(0.50, 0.26),
      vec2(0.27, 0.34),
      vec2(0.73, 0.35),
      vec2(0.38, 0.54),
      vec2(0.63, 0.55)
    );
    const float fanAngles[5] = float[5](1.57, 1.92, 1.22, 1.70, 1.44);
    const float fanRadii[5] = float[5](0.42, 0.35, 0.35, 0.36, 0.36);
    for (int i = 0; i < 5; i++) {
      float fi = float(i);
      vec2 jit = vec2(0.025 * sin(seed + fi * 2.3), 0.025 * cos(seed * 1.4 + fi * 1.7));
      vec2 rel = uv - (hubs[i] + jit);
      float m = PineNeedleFan(rel, fanAngles[i], fanRadii[i], seed + fi * 1.9);
      if (m > alpha) {
        alpha = m;
        toneAcc = clamp(length(rel) / fanRadii[i] * 0.78 + uv.y * 0.28, 0.0, 1.0);
      }
    }
    leafTone = toneAcc;
    return alpha;
  }

  float WillowFrondCoverage(vec2 uv, float seed, out float leafTone) {
    float alpha = 0.0;
    float toneAcc = 0.45;
    float hang = 1.0 - uv.y;
    for (int i = 0; i < 8; i++) {
      float fi = float(i);
      float xBase = 0.09 + (fi / 7.0) * 0.82 + 0.022 * sin(seed * 2.1 + fi * 3.3);
      float maxLen = 0.72 + 0.25 * fract(sin(fi * 17.3 + seed) * 213.7);
      if (hang <= maxLen) {
        float hFrac = clamp(hang / maxLen, 0.0, 1.0);
        float sway = 0.038 * sin(hang * 8.5 + seed + fi * 1.9) * hFrac;
        float stemX = xBase + sway;
        float dx = uv.x - stemX;
        float stemMask = 1.0 - smoothstep(0.007, 0.018, abs(dx));
        float pairCell = hang * 16.0 + fi * 0.7;
        float cellFrac = fract(pairCell) - 0.5;
        float leafReach = (0.078 - 0.030 * hFrac) * sin(clamp(hFrac * 3.14159265, 0.14, 3.0));
        float leafCurve = abs(cellFrac) - 0.24 * (1.0 - clamp(abs(dx) / max(0.012, leafReach), 0.0, 1.0));
        float leafMask = (1.0 - smoothstep(0.18, 0.36, leafCurve))
          * (1.0 - smoothstep(leafReach * 0.68, leafReach, abs(dx)));
        float m = max(stemMask * (1.0 - hFrac * 0.35), leafMask);
        if (m > alpha) {
          alpha = m;
          toneAcc = 0.30 + 0.50 * (1.0 - hFrac * 0.45) + 0.20 * fract(sin(fi * 7.1 + seed) * 19.3);
        }
      }
    }
    leafTone = clamp(toneAcc, 0.0, 1.0);
    return alpha;
  }

  void Surface(inout MaterialInputs material) {
    vec2 uv = GetUV0();
    vec4 vColor = GetVertexColor();
    vec3 worldPos = GetWorldPosition();

    float seed = vColor.r * 13.7 + vColor.g * 7.3 + vColor.b * 5.1;
    float kind = material_params.foliage_kind;
    float leafTone = 0.5;
    float coverage = 1.0;

    if (kind < 0.5) {
      coverage = MapleSprayCoverage(uv, seed, leafTone);
    } else if (kind < 1.5) {
      coverage = BambooSprayCoverage(uv, seed, leafTone);
    } else if (kind < 2.5) {
      coverage = MeadowTuftCoverage(uv, seed, leafTone);
    } else if (kind < 3.5) {
      coverage = PineSprayCoverage(uv, seed, leafTone);
    } else {
      coverage = WillowFrondCoverage(uv, seed, leafTone);
    }

    float clusterNoise = NoiseSimplex3(worldPos * 2.2, 77) * 0.5 + 0.5;
    float mixFactor = leafTone * 0.74 + clusterNoise * 0.26;

    vec3 leafColor = mix(
      material_params.leaf_primary.rgb,
      material_params.leaf_secondary.rgb,
      mixFactor
    );

    vec3 cardNormal = normalize(GetWorldNormal());
    vec3 upRef = abs(cardNormal.y) < 0.92 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(upRef, cardNormal));
    vec3 B = normalize(cross(cardNormal, T));
    vec2 centeredUv = fract(uv) - vec2(0.5);
    vec3 domeNormal = normalize(
      vec3(0.0, 1.0, 0.0) + T * (centeredUv.x * 0.55) + B * (centeredUv.y * 0.42)
    );
    vec3 leafNormal = normalize(mix(cardNormal, domeNormal, 0.72));

    vec3 viewDir = GetViewDirection();
    float skyFacing = leafNormal.y * 0.5 + 0.5;
    float rim = pow(clamp(1.0 - abs(dot(leafNormal, viewDir)), 0.0, 1.0), 1.8);

    float rootShade;
    if (kind > 1.5 && kind < 2.5 && uv.y < 1.5) {
      rootShade = mix(0.46, 1.18, clamp(uv.y, 0.0, 1.0));
    } else if (kind > 2.5 && kind < 3.5) {
      rootShade = mix(0.38, 1.16, skyFacing);
    } else if (kind > 3.5) {
      rootShade = (0.54 + 0.56 * skyFacing) * mix(0.88, 1.08, clamp(uv.y, 0.0, 1.0));
    } else {
      rootShade = 0.48 + 0.62 * skyFacing;
    }
    leafColor *= rootShade;

    float sunGain = material_params.sun_translucency;
    vec3 backlitGlow = material_params.leaf_secondary.rgb *
        ((rim * 0.62 + skyFacing * 0.38) * material_params.rim_warmth * sunGain);

    material.base_color = vec4(
      (leafColor + backlitGlow * 0.34) * vColor.rgb,
      coverage * material_params.leaf_primary.a * vColor.a
    );
    material.emissive = backlitGlow * vColor.rgb * 0.11;
    material.normal = leafNormal;
    material.metallic = 0.0;
    material.roughness = 0.985;

    PrepareMaterial(material);
  }
}
