material {
  name: "PaintedClouds",
  shading_model: unlit,
  blending: alpha,
  culling: none,
  depth_write: false,
  parameters: [
    { type: sampler2d, name: cloud_pano, hint: default_white },
    { type: float, name: night_mix, default: 0.0 },
    { type: float, name: opacity, default: 0.88 },
    { type: float, name: time_sec, default: 0.0 }
  ]
}

fragment {
  precision highp float;

  void Surface(inout MaterialInputs material) {
    vec2 uv = GetUV0();
    float t = material_params.time_sec;
    float night = clamp(material_params.night_mix, 0.0, 1.0);

    vec2 rawUv = vec2(uv.x + t * 0.0022, clamp(uv.y, 0.0, 1.0));
    vec2 wrappedUv = vec2(fract(rawUv.x), rawUv.y);
    vec3 srgb = textureGrad(cloud_pano, wrappedUv, dFdx(rawUv), dFdy(rawUv)).rgb;
    vec3 lin = pow(max(srgb, vec3(0.0)), vec3(2.2));

    // Extract warm luminous cumulus puffs against cool sky blue so PhysicalSkySource sun disk shines cleanly
    float warmOverBlue = clamp((lin.r - lin.b * 0.88) * 2.1, 0.0, 1.0);
    float luma = dot(lin, vec3(0.299, 0.587, 0.114));
    float cloudSignal = clamp(warmOverBlue * 0.74 + smoothstep(0.16, 0.68, luma) * 0.46, 0.0, 1.0);

    // Smoothly feather near horizon (uv.y -> 0) and overhead zenith (uv.y -> 1)
    float elevFade = smoothstep(0.02, 0.16, uv.y) * (1.0 - smoothstep(0.76, 0.99, uv.y));
    float rawAlpha = smoothstep(0.05, 0.42, cloudSignal) * elevFade;

    vec3 duskTint = lin * vec3(1.55, 1.32, 1.12);
    vec3 nightCloud = vec3(0.14, 0.22, 0.40) * (0.50 + 0.90 * luma);
    vec3 outRgb = mix(duskTint, nightCloud, night);
    float outAlpha = clamp(rawAlpha * material_params.opacity * mix(1.0, 0.34, night), 0.0, 0.92);

    material.base_color = vec4(outRgb, outAlpha);
    PrepareMaterial(material);
  }
}
