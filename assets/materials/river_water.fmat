material {
  name: "RiverWater",
  shading_model: lit,
  blending: alpha,
  culling: back,
  depth_write: false,
  engine_inputs: [scene_color, scene_depth],
  parameters: [
    { type: vec4, name: shallow_color, hint: source_color, default: [0.06, 0.23, 0.24, 0.80] },
    { type: vec4, name: deep_color, hint: source_color, default: [0.012, 0.055, 0.095, 0.96] },
    { type: vec4, name: foam_color, hint: source_color, default: [0.88, 0.92, 0.92, 0.94] },
    { type: float, name: flow_speed, default: 0.95 },
    { type: float, name: gust_strength, default: 1.0 },
    { type: float, name: time_sec, default: 0.0 }
  ]
}

fragment {
  precision highp float;

  float FastHash2(vec2 p, float seed) {
    vec3 p3 = fract(
      vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973) +
          vec3(seed * 0.0173, seed * 0.0317, seed * 0.0113)
    );
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
  }

  float FastVal2(vec2 p, float seed) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = FastHash2(i, seed);
    float b = FastHash2(i + vec2(1.0, 0.0), seed);
    float c = FastHash2(i + vec2(0.0, 1.0), seed);
    float d = FastHash2(i + vec2(1.0, 1.0), seed);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 2.0 - 1.0;
  }

  float FastFbm2_2(vec2 p, float seed) {
    return FastVal2(p, seed) * 0.6667 +
        FastVal2(p * 2.03 + 11.7, seed + 19.0) * 0.3333;
  }

  float FastFbm2_3(vec2 p, float seed) {
    return FastVal2(p, seed) * 0.5714 +
        FastVal2(p * 2.03 + 11.7, seed + 19.0) * 0.2857 +
        FastVal2(p * 4.09 + 23.1, seed + 37.0) * 0.1429;
  }

  vec2 EvaluateRiverSlope(
    vec2 p,
    float t,
    float flowSpeed,
    float gust,
    float riverMask,
    float mipFade
  ) {
    float flowGain = mix(0.24, 1.0, riverMask);
    float speedGain = mix(0.32, flowSpeed, riverMask);

    // Flow-warped organic eddies along +z (eliminates uniform straight wave bars)
    vec2 streamWarp = vec2(
      FastFbm2_2(vec2(p.x * 0.35, p.y * 0.16 - t * 0.22 * speedGain), 307.0),
      FastFbm2_2(vec2(p.x * 0.35 + 7.1, p.y * 0.16 - t * 0.28 * speedGain), 317.0)
    ) * 1.15;
    vec2 wp = p + streamWarp;

    const vec2 dirs[3] = vec2[3](
      vec2(0.31, 0.95),
      vec2(-0.56, 0.83),
      vec2(0.78, 0.62)
    );
    const float kLens[3] = float[3](2.2, 3.9, 6.4);
    const float amps[3] = float[3](0.012, 0.0085, 0.005);
    const float speeds[3] = float[3](1.95, 2.75, 3.60);

    vec2 grad = vec2(0.0);
    for (int i = 0; i < 3; i++) {
      float weight = i >= 2 ? mipFade : 1.0;
      float amp = amps[i] * flowGain * weight;
      float phase = dot(wp, dirs[i]) * kLens[i] - t * speeds[i] * speedGain;
      grad += dirs[i] * (kLens[i] * amp * cos(phase));
    }

    const vec2 eps = vec2(0.05, 0.0);
    vec2 ruvA = vec2(wp.x * 1.45, wp.y * 0.55 - t * 0.92 * speedGain);
    vec2 ruvB = vec2(wp.x * 2.85 + 2.3, wp.y * 1.15 - t * 1.38 * speedGain);
    float rC = FastVal2(ruvA, 733.0) * 0.62 + FastVal2(ruvB, 617.0) * 0.38 * mipFade;
    float rX = FastVal2(ruvA + eps.xy * 1.6, 733.0) * 0.62 + FastVal2(ruvB + eps.xy * 2.2, 617.0) * 0.38 * mipFade;
    float rY = FastVal2(ruvA + eps.yx * 0.8, 733.0) * 0.62 + FastVal2(ruvB + eps.yx * 1.1, 617.0) * 0.38 * mipFade;
    vec2 rippleGrad = vec2(rX - rC, rY - rC) / eps.x;

    float gustEnv = 0.55 + 0.45 * FastVal2(p * 0.14 - vec2(0.0, t * 0.55), 509.0);
    float capAmp = mix(0.010, 0.024, riverMask) * (0.58 + 0.42 * gust * gustEnv) * mix(0.35, 1.0, mipFade);
    grad += rippleGrad * capAmp;
    return grad;
  }

  void Surface(inout MaterialInputs material) {
    vec3 wp = GetWorldPosition();
    vec3 geomNormal = normalize(GetWorldNormal());
    vec3 viewDir = GetViewDirection();
    vec2 uv = GetUV0();
    float t = material_params.time_sec > 0.0001 ? material_params.time_sec : GetTime();

    float footprint = clamp(length(fwidth(wp)), 0.002, 1.5);
    float mipFade = 1.0 - smoothstep(0.04, 0.26, footprint);

    float riverMask = (1.0 - smoothstep(-0.05, 0.25, wp.y)) *
        (1.0 - smoothstep(14.0, 20.0, abs(wp.x)));
    float bankDist = min(uv.x, 1.0 - uv.x) * 2.0;
    float centerSpeed = mix(0.62, 1.24, smoothstep(0.0, 0.65, bankDist));

    vec2 waveGrad = EvaluateRiverSlope(
      wp.xz,
      t,
      material_params.flow_speed * centerSpeed,
      material_params.gust_strength,
      riverMask,
      mipFade
    );

    float fragDepth = GetFragmentViewDepth();
    float unrefractedDepth = GetSceneDepth(vec2(0.0));
    float rawPreThickness = max(0.0, unrefractedDepth - fragDepth);
    float viewCosY = clamp(abs(viewDir.y) * 1.15, 0.45, 1.0);
    float preThickness = rawPreThickness * viewCosY;

    float shoreWarp = FastVal2(wp.xz * 0.72, 419.0) * 0.14 +
        FastVal2(wp.xz * 1.95, 431.0) * 0.065;
    float organicPreThickness = max(0.0, preThickness + shoreWarp);

    float ringEnvelope = smoothstep(0.015, 0.085, organicPreThickness) *
        (1.0 - smoothstep(0.16, 0.34, organicPreThickness)) *
        smoothstep(0.04, 0.22, bankDist) *
        riverMask;
    float ringNoise = FastVal2(wp.xz * 2.2 - vec2(0.0, t * 0.75), 202.0);
    float ringPhase = organicPreThickness * 28.0 - t * 3.1 + ringNoise * 2.2;
    float ringSlope = cos(ringPhase) * ringEnvelope * 0.036 * mipFade;

    vec2 dampedWaveGrad = waveGrad * mix(0.45, 1.0, smoothstep(0.04, 0.45, organicPreThickness));
    vec3 rippledNormal = normalize(
      geomNormal + vec3(dampedWaveGrad.x + ringSlope, 0.0, dampedWaveGrad.y + ringSlope * 0.75)
    );

    float refractStrength = clamp(preThickness * 0.048, 0.0, 0.018) * mix(0.32, 1.0, riverMask);
    vec2 candidateOffset = rippledNormal.xz * refractStrength;
    float candidateDepth = GetSceneDepth(candidateOffset);
    bool foregroundBlocked = candidateDepth < fragDepth + 0.005;
    vec2 refractUvOffset = foregroundBlocked ? vec2(0.0) : candidateOffset;
    float validSceneDepth = foregroundBlocked ? unrefractedDepth : candidateDepth;

    float rawThickness = max(0.0, validSceneDepth - fragDepth);
    float thickness = rawThickness * viewCosY;
    float organicThickness = max(0.0, thickness + shoreWarp);
    float shoreFeather = smoothstep(0.0, 0.55, organicThickness);
    float bankGlintGate = smoothstep(0.06, 0.32, organicThickness);

    vec3 bedPos = GetSceneWorldPosition(refractUvOffset);
    bool hasValidBedPos = frag_info.scene_inputs.y > 0.5 &&
        frag_info.scene_inputs.w > 0.0 &&
        frag_info.camera_forward.w > 0.0 &&
        validSceneDepth < 1.0e6;
    vec2 causticWorldXZ = hasValidBedPos ? bedPos.xz : (wp.xz + rippledNormal.xz * 0.32);

    vec2 cUv1 = causticWorldXZ * 2.25 +
        vec2(t * 0.20, -t * 0.54 * material_params.flow_speed) +
        rippledNormal.xz * 0.42;
    vec2 cUv2 = causticWorldXZ * 2.75 +
        vec2(-t * 0.16 + 3.7, -t * 0.38 * material_params.flow_speed + 1.9) -
        rippledNormal.xz * 0.34;
    float cellA = abs(FastVal2(cUv1, 821.0));
    float cellB = abs(FastVal2(cUv2, 839.0));
    float ridgeA = 1.0 - smoothstep(0.014, 0.21, cellA);
    float ridgeB = 1.0 - smoothstep(0.014, 0.21, cellB);
    float causticPattern = pow(
      clamp(ridgeA * 0.58 + ridgeB * 0.58 + ridgeA * ridgeB * 0.90, 0.0, 1.35),
      1.68
    ) * mix(0.35, 1.0, mipFade);
    float causticAtten = smoothstep(0.08, 0.34, thickness) *
        exp(-thickness * 2.0) *
        riverMask;

    vec3 sunTint = frag_info.has_directional_light > 0.5
        ? clamp(frag_info.directional_light_color.rgb * 0.26, vec3(0.04), vec3(1.26, 0.96, 0.52))
        : vec3(0.95, 0.74, 0.38);
    vec3 causticRadiance = sunTint * vec3(1.0, 0.85, 0.60) * (causticPattern * causticAtten * 0.12);

    vec3 transmittance = exp(-vec3(2.8, 1.05, 0.85) * thickness);
    vec3 shallowClearTrans = exp(-vec3(1.15, 0.56, 0.50) * thickness);
    vec3 riverTransmittance = mix(shallowClearTrans, transmittance, smoothstep(0.06, 0.54, thickness));
    float depthT = clamp(1.0 - exp(-thickness * 1.48), 0.0, 1.0);

    vec3 shallowStoneTint = vec3(0.115, 0.165, 0.130);
    vec3 jadeMid = mix(material_params.shallow_color.rgb, vec3(0.028, 0.185, 0.185), 0.72);
    vec3 prussianThalweg = mix(material_params.deep_color.rgb, vec3(0.010, 0.044, 0.088), 0.68);
    vec3 volumeColor = mix(shallowStoneTint, jadeMid, smoothstep(0.08, 0.48, thickness));
    volumeColor = mix(volumeColor, prussianThalweg, smoothstep(0.52, 1.10, thickness));

    vec3 calmPaddyBody = vec3(0.088, 0.195, 0.145);
    vec3 waterBodyColor = mix(calmPaddyBody, volumeColor, riverMask);

    // Soft flow-elongated FBM current wisps & delicate shoreline/boulder wake collars
    float collarEnv = smoothstep(0.015, 0.06, organicThickness) *
        (1.0 - smoothstep(0.08, 0.28, organicThickness)) *
        riverMask;
    float midStreamRapids = smoothstep(0.45, 0.88,
      FastFbm2_2(vec2(wp.x * 0.95, wp.z * 0.55 - t * 0.95 * material_params.flow_speed), 547.0) * 0.5 + 0.5
    ) * smoothstep(0.18, 0.50, organicThickness) * riverMask;
    float flowWisp = FastFbm2_3(
      vec2(wp.x * 2.4, wp.z * 0.55 - t * 1.15 * material_params.flow_speed),
      503.0
    ) * 0.5 + 0.5;
    float fineFroth = FastFbm2_2(
      vec2(wp.x * 5.2 + 1.9, wp.z * 1.8 - t * 1.45 * material_params.flow_speed),
      521.0
    ) * 0.5 + 0.5;
    float bubbleLace = smoothstep(0.46, 0.84, flowWisp * 0.65 + fineFroth * 0.35 * mipFade);
    float wakePatch = smoothstep(
      0.22,
      0.78,
      FastVal2(vec2(wp.x * 1.65, wp.z * 1.05 - t * 0.78), 541.0) * 0.5 + 0.5
    );
    float collarFoam = collarEnv *
        smoothstep(0.26, 0.74, bubbleLace * (0.58 + 0.52 * wakePatch));
    float rapidStreaks = midStreamRapids * smoothstep(0.48, 0.86, bubbleLace) * 0.34;
    float foamStrength = clamp(collarFoam * 0.78 + rapidStreaks, 0.0, 0.72);

    vec3 rawLD = frag_info.directional_light_direction.xyz;
    float lenLD2 = dot(rawLD, rawLD);
    vec3 toSun = (frag_info.has_directional_light > 0.5 && lenLD2 > 1e-6)
        ? (-rawLD * inversesqrt(lenLD2))
        : normalize(vec3(-0.58, 0.46, -0.67));
    vec3 halfVec = normalize(toSun + viewDir);
    float nDotH = max(dot(rippledNormal, halfVec), 0.0);
    float sunSpecTight = pow(nDotH, 360.0) * 1.10;
    float sunSpecBroad = pow(nDotH, 48.0) * 0.08;
    float sunElevGate = smoothstep(-0.02, 0.16, toSun.y);
    vec3 sunGlint = sunTint *
        (sunSpecTight + sunSpecBroad) *
        sunElevGate *
        (1.0 - foamStrength * 0.76) *
        bankGlintGate;

    float nDotV = clamp(dot(rippledNormal, viewDir), 0.0, 1.0);
    float fresnel = 0.02 + 0.98 * pow(1.0 - nDotV, 5.0);
    vec3 reflDir = reflect(-viewDir, rippledNormal);
    float horizonWarm = pow(clamp(dot(reflDir, toSun) * 0.5 + 0.5, 0.0, 1.0), 2.4);
    vec3 skyReflectColor = mix(vec3(0.10, 0.18, 0.28), sunTint * 0.72, horizonWarm);
    vec3 skySheen = skyReflectColor *
        (fresnel * 0.28 + pow(1.0 - nDotV, 4.0) * 0.08) *
        mix(0.45, 1.0, riverMask) *
        bankGlintGate;

    vec3 outBaseRgb;
    vec3 outEmissive;
    float outAlpha;

    if (frag_info.scene_inputs.x > 0.5) {
      vec3 sceneBedColor = GetSceneColor(refractUvOffset);
      vec3 warmShallowWash = mix(vec3(1.0), vec3(1.14, 1.08, 0.96), smoothstep(0.32, 0.0, thickness) * riverMask);
      vec3 paddyTransmittance = exp(-vec3(1.65, 0.92, 0.88) * thickness);
      vec3 activeTransmittance = mix(paddyTransmittance * 0.62, riverTransmittance, riverMask);

      vec3 transmittedBed = (sceneBedColor * warmShallowWash + causticRadiance) *
          activeTransmittance *
          (1.0 - fresnel * 0.86) *
          (1.0 - foamStrength);

      vec3 inScatteredBody = waterBodyColor * (vec3(1.0) - activeTransmittance);
      outBaseRgb = mix(inScatteredBody, material_params.foam_color.rgb * 0.90, foamStrength);
      outAlpha = clamp(mix(max(0.76, fresnel), 0.98, depthT), 0.0, 1.0);
      outAlpha = mix(outAlpha, max(outAlpha, 0.94), foamStrength);
      outEmissive = transmittedBed * mix(0.84, 1.0, depthT) + skySheen + sunGlint;
    } else {
      outBaseRgb = mix(waterBodyColor, material_params.foam_color.rgb * 0.90, foamStrength);
      outAlpha = clamp(mix(max(0.48, fresnel), 0.96, depthT), 0.0, 1.0);
      outAlpha = mix(outAlpha, max(outAlpha, 0.92), foamStrength);
      outEmissive = causticRadiance * transmittance * (1.0 - foamStrength) * 0.45 + skySheen + sunGlint;
    }

    outAlpha *= shoreFeather;
    outEmissive *= shoreFeather;

    material.base_color = vec4(outBaseRgb, outAlpha);
    material.emissive = outEmissive;
    material.normal = rippledNormal;
    material.metallic = 0.02;
    material.roughness = mix(0.12, mix(0.15, 0.54, foamStrength), riverMask);
    material.specular = mix(0.68, 0.58, foamStrength);
    material.occlusion = mix(0.92, 1.0, 1.0 - depthT * 0.25);

    PrepareMaterial(material);
  }
}
