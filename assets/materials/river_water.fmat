material {
  name: "RiverWater",
  shading_model: lit,
  blending: alpha,
  culling: back,
  depth_write: false,
  engine_inputs: [scene_depth],
  parameters: [
    { type: vec4, name: shallow_color, hint: source_color, default: [0.07, 0.24, 0.25, 0.78] },
    { type: vec4, name: deep_color, hint: source_color, default: [0.015, 0.065, 0.11, 0.96] },
    { type: vec4, name: foam_color, hint: source_color, default: [0.84, 0.90, 0.90, 0.90] },
    { type: float, name: flow_speed, default: 0.95 },
    { type: float, name: time_sec, default: 0.0 }
  ]
}

fragment {
  #include <noise.glsl>

  void Surface(inout MaterialInputs material) {
    float sceneDepth = GetSceneDepth(vec2(0.0));
    float fragDepth = GetFragmentViewDepth();
    float thickness = max(0.0, sceneDepth - fragDepth);

    float depthT = clamp(1.0 - exp(-thickness * 1.15), 0.0, 1.0);
    vec4 waterColor = mix(
      material_params.shallow_color,
      material_params.deep_color,
      depthT
    );

    float t = material_params.time_sec > 0.0 ? material_params.time_sec : GetTime();
    vec2 uv = GetUV0();
    float bankDist = min(uv.x, 1.0 - uv.x) * 2.0;
    float centerSpeed = mix(0.55, 1.15, smoothstep(0.0, 0.65, bankDist));

    float downstreamV = uv.y * 2.6 - t * material_params.flow_speed * 0.48 * centerSpeed;
    float crossU = uv.x * 3.4 + 0.08 * sin(uv.y * 4.0 - t * 0.8);

    float streakNoise = NoiseFbm2(
      vec2(crossU * 2.8, downstreamV * 0.55),
      202,
      3,
      2.0,
      0.5
    );
    float fineWake = NoiseSimplex2(
      vec2(crossU * 6.2, downstreamV * 1.35 - t * 0.35),
      409
    );

    float obstacleBand = clamp(1.0 - thickness / 0.46, 0.0, 1.0);
    float bankFoamBand = clamp(1.0 - bankDist / 0.14, 0.0, 1.0) * 0.46;
    float currentRibbon = smoothstep(0.32, 0.76, streakNoise * 0.5 + 0.5) * 0.30;
    float wakeBreakup = clamp(0.55 + 0.55 * streakNoise + 0.32 * fineWake, 0.15, 1.25);
    float foamMask = smoothstep(
      0.38,
      0.82,
      max(obstacleBand * wakeBreakup, bankFoamBand) + currentRibbon * 0.65
    );
    float foamStrength = clamp(foamMask * 0.78 + currentRibbon * (0.35 + 0.55 * obstacleBand), 0.0, 0.88);

    vec4 finalColor = mix(waterColor, material_params.foam_color, foamStrength);
    finalColor.rgb += material_params.foam_color.rgb * (currentRibbon * (1.0 - depthT * 0.45) * 0.18);

    float rippleA = NoiseSimplex2(
      vec2(crossU * 4.6, downstreamV * 1.9),
      303
    );
    float rippleB = NoiseSimplex2(
      vec2(crossU * 8.4 + 1.7, downstreamV * 3.2 - t * 0.6),
      617
    );
    vec3 geomNormal = GetWorldNormal();
    vec3 rippledNormal = normalize(
      geomNormal + vec3((rippleA + rippleB * 0.5) * 0.055, 0.0, (rippleA - rippleB * 0.5) * 0.085)
    );

    material.base_color = finalColor;
    material.normal = rippledNormal;
    material.metallic = 0.02;
    material.roughness = mix(0.11, 0.42, foamStrength);
    material.specular = 0.88;

    PrepareMaterial(material);
  }
}
