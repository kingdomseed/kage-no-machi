material {
  name: "MountainVista",
  shading_model: lit,
  blending: opaque,
  culling: back,
  parameters: [
    { type: sampler2d, name: mountain_albedo, hint: default_white },
    { type: sampler2d, name: mountain_normal, hint: default_white },
    { type: vec4, name: haze_color, hint: source_color, default: [0.068, 0.090, 0.175, 1.0] },
    { type: vec4, name: sun_rim_color, hint: source_color, default: [0.34, 0.17, 0.08, 1.0] },
    { type: float, name: night_mix, default: 0.0 },
    { type: float, name: texture_scale, default: 1.0 }
  ]
}

fragment {
  precision highp float;

  float FastHash2(vec2 p, float seed) {
    vec3 p3 = fract(
      vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973) +
          vec3(seed * 0.0173, seed * 0.0317, seed * 0.0113)
    );
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
  }

  float FastVal2(vec2 p, float seed) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = FastHash2(i, seed);
    float b = FastHash2(i + vec2(1.0, 0.0), seed);
    float c = FastHash2(i + vec2(0.0, 1.0), seed);
    float d = FastHash2(i + vec2(1.0, 1.0), seed);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 2.0 - 1.0;
  }

  vec3 Linearize(vec3 srgb) {
    return pow(max(srgb, vec3(0.0)), vec3(2.2));
  }

  void Surface(inout MaterialInputs material) {
    vec3 P = GetWorldPosition();
    vec3 N = normalize(GetWorldNormal());
    vec2 uv0 = GetUV0();
    vec4 vColor = GetVertexColor();
    float night = clamp(material_params.night_mix, 0.0, 1.0);

    vec3 upRef = abs(N.y) < 0.92 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(upRef, N));
    vec3 B = normalize(cross(N, T));

    // Anti-tiled dual-scale forested ridge sampling + crag canopy micro-stipple
    vec2 mUvA = uv0 * (2.25 * material_params.texture_scale);
    vec2 mUvB = (mat2(0.8, -0.6, 0.6, 0.8) * uv0) * (1.28 * material_params.texture_scale) + vec2(0.37, 0.61);
    float tileBlend = smoothstep(0.25, 0.75, FastVal2(uv0 * 0.65, 977.0) * 0.5 + 0.5);

    vec3 texAlb = mix(
      Linearize(texture(mountain_albedo, mUvA).rgb),
      Linearize(texture(mountain_albedo, mUvB).rgb),
      tileBlend
    );
    vec3 tnA = texture(mountain_normal, mUvA).xyz * 2.0 - 1.0;
    vec3 tnB = texture(mountain_normal, mUvB).xyz * 2.0 - 1.0;
    vec3 tn = normalize(mix(tnA, tnB, tileBlend));

    float normElev = clamp(vColor.r, 0.0, 1.0);
    float gullyAo = clamp(vColor.g, 0.30, 1.0);
    float sunRim = clamp(vColor.b, 0.0, 1.0);
    float outerTier = clamp(vColor.a, 0.0, 1.0);

    float forestLuma = dot(texAlb, vec3(0.299, 0.587, 0.114));
    float cliffMask = 1.0 - smoothstep(0.56, 0.85, N.y);
    float macroNoise = FastVal2(P.xz * 0.14 + P.y * 0.08, 313.0) * 0.5 + 0.5;
    float canopyStipple = FastVal2(P.xz * 0.42 + P.y * 0.15, 761.0) * 0.5 + 0.5;
    float cragDetail = FastVal2(P.xz * 1.35 - P.y * 0.22, 509.0) * 0.5 + 0.5;
    float foliageDetail = clamp(0.42 * macroNoise + 0.38 * canopyStipple + 0.20 * cragDetail, 0.0, 1.0);

    vec3 pineForestTint = mix(vec3(0.075, 0.145, 0.062), vec3(0.165, 0.255, 0.098), foliageDetail);
    vec3 graniteCliff = mix(
      vec3(0.085, 0.095, 0.112),
      vec3(0.240, 0.225, 0.215),
      clamp(forestLuma * 1.15 + (cragDetail - 0.5) * 0.42, 0.0, 1.0)
    );
    vec3 texturedSlope = mix(texAlb * vec3(0.86, 0.94, 0.76), pineForestTint, 0.48 * (1.0 - cliffMask));
    vec3 ridgeBase = mix(
      texturedSlope * mix(vec3(0.92, 0.98, 0.90), vec3(1.12, 1.02, 0.92), normElev),
      graniteCliff,
      cliffMask * 0.72
    );
    ridgeBase = mix(vec3(0.036, 0.056, 0.088), ridgeBase * 1.08, gullyAo);
    float lowForest = 1.0 - smoothstep(0.08, 0.56, normElev);
    ridgeBase = mix(
      ridgeBase,
      pineForestTint * 1.12,
      lowForest * 0.72 * (1.0 - outerTier * 0.32)
    );
    float shoreBasalt = 1.0 - smoothstep(0.15, 2.8, P.y);
    ridgeBase = mix(ridgeBase, vec3(0.038, 0.044, 0.052), shoreBasalt * 0.78);

    vec3 perturbedN = normalize(
      N + (T * (tn.x + (cragDetail - 0.5) * 0.42) + B * (tn.y + (macroNoise - 0.5) * 0.42)) * mix(0.52, 0.28, outerTier)
    );

    // Ukiyo-e layered atmospheric perspective: let forested slopes & cliffs read crisply
    vec2 radialXZ = normalize(P.xz + vec2(1e-4, 0.0));
    float sunAlign = clamp(dot(radialXZ, normalize(vec2(0.855, -0.437))) * 0.5 + 0.5, 0.0, 1.0);
    float dist = length(P.xz);
    float valleyMist = exp(-max(P.y + 4.0, 0.0) * 0.085) * smoothstep(92.0, 140.0, dist);
    float crestFade = smoothstep(0.38, 0.94, normElev);

    vec3 coolMist = vec3(0.11, 0.13, 0.19);
    vec3 warmMist = vec3(0.24, 0.16, 0.13);
    vec3 baseHaze = mix(
      coolMist,
      warmMist,
      pow(sunAlign, 1.45) * (0.30 + 0.52 * outerTier) * (0.45 + 0.55 * crestFade)
    );
    vec3 nightHaze = vec3(0.045, 0.082, 0.165);
    vec3 activeHaze = mix(baseHaze, nightHaze, night);

    float mistWeight = clamp(
      mix(0.06, 0.28, outerTier) + valleyMist * 0.16,
      0.0,
      0.44
    );
    vec3 surfaceRgb = mix(ridgeBase, activeHaze, mistWeight);

    vec3 duskCrestGlow = warmMist *
        (sunRim * pow(sunAlign, 1.8) * mix(0.03, 0.11, outerTier) * (1.0 - night));

    material.base_color = vec4(surfaceRgb, 1.0);
    material.emissive = duskCrestGlow;
    material.normal = perturbedN;
    material.metallic = 0.0;
    material.roughness = 1.0;
    material.specular = 0.0;
    material.occlusion = mix(gullyAo, 0.94, outerTier * 0.50);

    PrepareMaterial(material);
  }
}
