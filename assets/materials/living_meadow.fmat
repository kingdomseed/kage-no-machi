material {
  name: "LivingMeadow",
  shading_model: lit,
  blending: opaque,
  alpha_to_coverage: true,
  culling: none,
  parameters: [
    { type: float, name: sun_translucency, default: 1.0 },
    { type: float, name: gust_strength, default: 1.0 },
    { type: float, name: dew_sheen, default: 0.22 },
    { type: float, name: time_sec, default: 0.0 }
  ]
}

vertex {
  void Vertex(inout VertexInputs vertex) {
    float t = material_params.time_sec;
    float subKind = vertex.color.a;
    float s = clamp(vertex.position.y, 0.0, 1.40);
    vec3 wp = vertex.world_position;
    vec3 instOrigin = vertex.model_transform[3].xyz;

    float instHash = fract(
      sin(dot(instOrigin.xz, vec2(12.9898, 78.233))) * 43758.5453
    );
    float bHash = subKind < 0.25
      ? fract(instHash + vertex.position.x * 19.1 + vertex.position.z * 11.3)
      : instHash;

    if (subKind < 0.25) {
      wp.y += (bHash - 0.48) * 0.07 * s;
    }

    const vec2 windDir = vec2(0.7808688, 0.6246950);
    const vec2 crossDir = vec2(-0.6246950, 0.7808688);

    float spatialPhase = sin(instOrigin.x * 0.19 + instOrigin.z * 0.13) * 1.7
      + cos(instOrigin.z * 0.17 - instOrigin.x * 0.11) * 1.5
      + bHash * 6.2831853;
    float slowBreath = sin(t * 0.72 + spatialPhase);
    float gentleDrift = cos(t * 1.14 - spatialPhase * 0.63 + bHash * 3.1);

    float reachScale = subKind < 0.25
      ? (0.022 + 0.010 * bHash)
      : (subKind < 0.55 ? 0.044 : 0.020);
    float flex = pow(max(s, 0.0), 1.65) * material_params.gust_strength;

    float alongPush = (0.32 + 0.68 * (0.5 + 0.5 * slowBreath)) * reachScale * flex;
    float crossPush = gentleDrift * reachScale * 0.42 * flex;

    vec2 dispXZ = windDir * alongPush + crossDir * crossPush;
    wp.xz += dispXZ;
    wp.y -= min(0.04, dot(dispXZ, dispXZ) * 0.65);
    vertex.world_position = wp;

    vertex.uv1 = vec2(bHash, 0.0);
  }
}

fragment {
  #include <noise.glsl>
  precision highp float;

  float ComputeAtmosphericGobo(vec2 worldXZ, float t) {
    float cloudMacro = NoiseFbm2(
      worldXZ * 0.028 + vec2(t * 0.012, -t * 0.008),
      1103,
      3,
      2.0,
      0.5
    ) * 0.5 + 0.5;
    float cloudClearing = smoothstep(0.28, 0.74, cloudMacro);
    float woodlandZone = clamp(
      smoothstep(5.5, 16.0, abs(worldXZ.y)) * 0.72 +
          smoothstep(18.0, 38.0, length(worldXZ)) * 0.48,
      0.18,
      1.0
    );
    float canopyBough = NoiseSimplex2(
      worldXZ * 0.24 + vec2(t * 0.032, t * 0.019),
      1117
    ) * 0.5 + 0.5;
    float canopyLeafGap = NoiseSimplex2(
      worldXZ * 0.62 - vec2(t * 0.048, -t * 0.026),
      1129
    ) * 0.5 + 0.5;
    float canopyDapple = smoothstep(0.26, 0.78, canopyBough * 0.64 + canopyLeafGap * 0.36);
    return mix(
      cloudClearing,
      cloudClearing * (0.56 + 0.44 * canopyDapple),
      woodlandZone * 0.68
    );
  }

  float SusukiPlumeCoverage(vec2 uv, float seed, out float plumeTone) {
    vec2 p = vec2((uv.x - 0.5) * 2.0, clamp(uv.y, 0.0, 1.0));
    float spine = 1.0 - smoothstep(0.040, 0.115, abs(p.x - 0.08 * p.y * p.y));
    float alpha = spine * (1.0 - smoothstep(0.90, 1.0, p.y));
    float tone = 0.55 + 0.45 * p.y;
    for (int i = 0; i < 6; i++) {
      float fi = float(i);
      float baseH = 0.08 + fi * 0.14;
      for (int side = -1; side <= 1; side += 2) {
        float fs = float(side);
        vec2 origin = vec2(0.08 * baseH * baseH, baseH);
        float ang = 1.5707963 - fs * (0.42 + 0.05 * fi + 0.04 * sin(seed * 6.0 + fi));
        vec2 dir = vec2(cos(ang), sin(ang));
        vec2 perp = vec2(-dir.y, dir.x);
        vec2 rel = p - origin;
        float len = 0.48 - 0.04 * fi;
        float along = dot(rel, dir);
        if (along > -0.01 && along < len) {
          float u = clamp(along / len, 0.0, 1.0);
          float droop = -0.11 * fs * u * u;
          float hw = sin(pow(u, 0.55) * 3.14159265) * 0.084 * (1.0 - 0.22 * u);
          float m = 1.0 - smoothstep(hw * 0.35, hw * 1.05, abs(dot(rel, perp) - droop));
          if (m > alpha) {
            alpha = m;
            tone = 0.45 + 0.55 * u;
          }
        }
      }
    }
    plumeTone = tone;
    return alpha;
  }

  float NogikuFlowerCoverage(vec2 uv, float seed, out float isCenter) {
    vec2 p = (uv - vec2(0.5, 0.5)) * 2.10;
    float r = length(p);
    if (r > 1.05) {
      isCenter = 0.0;
      return 0.0;
    }
    float disk = 1.0 - smoothstep(0.20, 0.30, r);
    float ang = atan(p.y, p.x) + seed * 6.2831853;
    float petals = 0.5 + 0.5 * cos(ang * 9.0);
    float petalRadius = 0.34 + 0.56 * pow(petals, 0.58);
    float ring = (1.0 - smoothstep(petalRadius * 0.76, petalRadius, r))
      * smoothstep(0.15, 0.25, r);
    isCenter = disk;
    return max(disk, ring);
  }

  float HiganbanaCoverage(vec2 uv, float seed, out float tipGlow) {
    vec2 p = (uv - vec2(0.5, 0.48)) * 2.18;
    float r = length(p);
    if (r > 1.08) {
      tipGlow = 0.0;
      return 0.0;
    }
    float ang = atan(p.y, p.x) + seed * 6.2831853;
    float rays = abs(cos(ang * 6.0 + 0.28 * sin(r * 5.5)));
    float target = 0.22 + 0.74 * pow(rays, 1.45);
    float fil = 1.0 - smoothstep(target * 0.72, target, r);
    float core = 1.0 - smoothstep(0.16, 0.26, r);
    tipGlow = clamp(r * 0.95, 0.0, 1.0);
    return max(core, fil);
  }

  void Surface(inout MaterialInputs material) {
    vec2 uv = GetUV0();
    float bHash = GetUV1().x;
    vec4 vColor = GetVertexColor();
    vec3 worldPos = GetWorldPosition();
    vec3 viewDir = GetViewDirection();
    float subKind = vColor.a;
    float s = clamp(uv.y, 0.0, 1.0);
    float t = material_params.time_sec > 0.0001 ? material_params.time_sec : GetTime();

    float goboLight = ComputeAtmosphericGobo(worldPos.xz, t);
    vec3 goboTint = mix(vec3(0.79, 0.86, 0.96), vec3(1.13, 1.06, 0.96), goboLight);

    vec3 rawLightDir = frag_info.directional_light_direction.xyz;
    float rawLightLen2 = dot(rawLightDir, rawLightDir);
    vec3 sunTravel = (frag_info.has_directional_light > 0.5 && rawLightLen2 > 1e-6)
        ? rawLightDir * inversesqrt(rawLightLen2)
        : normalize(vec3(0.58, -0.46, 0.67));
    float forwardScatter = pow(clamp(dot(viewDir, sunTravel), 0.0, 1.0), 2.2);
    vec3 sunWarmth = frag_info.has_directional_light > 0.5
        ? clamp(frag_info.directional_light_color.rgb * 0.28, vec3(0.14), vec3(1.22, 1.00, 0.66))
        : vec3(1.0, 0.84, 0.58);

    float coverage = 1.0;
    vec3 albedo;
    vec3 emissive = vec3(0.0);
    float spec = 0.12;
    float tuftOcclusion;

    if (subKind < 0.25) {
      float rootAo = mix(0.20, 1.0, smoothstep(0.0, 0.72, s));
      float tipSun = smoothstep(0.22, 1.0, s);

      vec3 deepRoot = vec3(0.020, 0.032, 0.014);
      vec3 sageMid = vec3(0.072, 0.142, 0.044);
      vec3 sunlitOlive = vec3(0.195, 0.258, 0.082);
      vec3 autumnStraw = vec3(0.340, 0.258, 0.100);

      float patchTone = 0.5 + 0.5 * NoiseSimplex2(worldPos.xz * 0.16, 193);
      float strawMix = clamp(
        (1.0 - patchTone) * 0.44 + max(0.0, vColor.r - vColor.g) * 1.3 + (bHash - 0.5) * 0.20,
        0.0,
        0.74
      );
      vec3 oliveBlade = mix(sageMid, sunlitOlive, tipSun);
      vec3 bladeRgb = mix(oliveBlade, autumnStraw, strawMix * (0.36 + 0.64 * s));
      bladeRgb = mix(deepRoot, bladeRgb, rootAo);
      bladeRgb *= mix(vec3(0.88), vColor.rgb * 1.12, 0.48);

      vec3 geoN = normalize(GetWorldNormal());
      float rimTranslucency = pow(1.0 - clamp(abs(dot(viewDir, geoN)), 0.0, 1.0), 2.0) * tipSun;
      float backFacing = clamp(dot(geoN, sunTravel) * 0.65 + 0.35, 0.0, 1.0);
      float backLight = clamp(
        backFacing * (0.35 + 0.85 * forwardScatter) + rimTranslucency * 0.48,
        0.0,
        1.30
      ) * tipSun;

      vec3 transGlow = vec3(0.115, 0.148, 0.038) *
          sunWarmth *
          backLight *
          material_params.sun_translucency *
          mix(0.68, 1.14, goboLight);
      bladeRgb += transGlow * 0.52;

      float midrib = (uv.x - 0.5) * 0.24;
      material.normal = normalize(mix(geoN + vec3(midrib, 0.0, -midrib), vec3(0.0, 1.0, 0.0), 0.52));

      float dewMix = material_params.dew_sheen * tipSun;
      spec = mix(0.14, 0.38, dewMix);
      albedo = bladeRgb;
      emissive = (bladeRgb * 0.018 * tipSun + transGlow * 0.26) * material_params.sun_translucency;
      tuftOcclusion = mix(0.22, 1.0, pow(s, 0.80));
    } else if (subKind < 0.55) {
      float plumeTone = 0.5;
      coverage = SusukiPlumeCoverage(uv, bHash, plumeTone);
      vec3 stemGold = vec3(0.28, 0.22, 0.10);
      vec3 silkyPlume = vec3(0.80, 0.72, 0.52);
      vec3 basePlume = mix(stemGold, silkyPlume, plumeTone) * vColor.rgb;
      float backLight = (0.38 + 0.88 * forwardScatter) * plumeTone;
      vec3 plumeGlow = silkyPlume *
          sunWarmth *
          backLight *
          material_params.sun_translucency *
          mix(0.72, 1.15, goboLight);
      albedo = basePlume + plumeGlow * 0.28;
      material.normal = vec3(0.0, 1.0, 0.0);
      spec = 0.24;
      emissive = plumeGlow * 0.14;
      tuftOcclusion = mix(0.38, 1.0, smoothstep(0.0, 0.75, s));
    } else if (subKind < 0.80) {
      float isCenter = 0.0;
      coverage = NogikuFlowerCoverage(uv, bHash, isCenter);
      vec3 ivoryPetal = mix(vec3(0.78, 0.80, 0.74), vec3(0.94, 0.92, 0.86), vColor.r);
      vec3 yomenaPetal = vec3(0.78, 0.75, 0.92);
      vec3 petalTone = mix(ivoryPetal, yomenaPetal, step(0.80, bHash) * 0.72);
      vec3 stamenGold = vec3(0.82, 0.55, 0.08);
      albedo = mix(petalTone, stamenGold, isCenter);
      material.normal = vec3(0.0, 1.0, 0.0);
      spec = 0.18;
      float backLight = 0.35 + 0.65 * forwardScatter;
      emissive = albedo * sunWarmth * (0.055 * backLight * material_params.sun_translucency);
      tuftOcclusion = mix(0.55, 1.0, smoothstep(0.0, 0.65, s));
    } else {
      float tipGlow = 0.0;
      coverage = HiganbanaCoverage(uv, bHash, tipGlow);
      vec3 coreCrimson = vec3(0.34, 0.018, 0.016);
      vec3 filamentScarlet = vec3(0.80, 0.072, 0.030);
      albedo = mix(coreCrimson, filamentScarlet, tipGlow) * vColor.rgb;
      material.normal = vec3(0.0, 1.0, 0.0);
      spec = 0.22;
      float backLight = (0.38 + 0.72 * forwardScatter) * (0.4 + 0.6 * tipGlow);
      emissive = albedo * sunWarmth * (0.068 * backLight * material_params.sun_translucency);
      tuftOcclusion = mix(0.48, 1.0, smoothstep(0.0, 0.70, s));
    }

    float patchDapple = 0.94 + 0.12 * NoiseSimplex2(worldPos.xz * 0.38, 409);
    material.base_color = vec4(albedo * patchDapple * goboTint, coverage);
    material.roughness = 0.96;
    material.metallic = 0.0;
    material.specular = spec;
    material.occlusion = clamp(tuftOcclusion * mix(0.84, 1.0, goboLight), 0.22, 1.0);
    material.emissive = emissive;

    PrepareMaterial(material);
  }
}
