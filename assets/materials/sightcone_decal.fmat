material {
  name: "SightconeDecal",
  shading_model: unlit,
  blending: alpha,
  culling: front,
  depth_test: always,
  engine_inputs: [scene_depth],
  scene_color_reach: 0.0,
  parameters: [
    { type: mat4, name: decal_inverse },
    { type: float, name: decal_fade, default: 1.0 },
    { type: float, name: half_angle_rad, default: 0.45 },
    { type: float, name: cone_range_norm, default: 1.0 },
    { type: vec4, name: cone_color, hint: source_color, default: [0.18, 0.78, 0.56, 0.52] },
    { type: vec4, name: alert_color, hint: source_color, default: [0.92, 0.34, 0.18, 0.65] },
    { type: float, name: alert_mix, default: 0.0 },
    { type: float, name: time_sec, default: 0.0 }
  ]
}

fragment {
  void Surface(inout MaterialInputs material) {
    highp vec3 worldPos = GetSceneWorldPosition(vec2(0.0));
    highp vec3 local = (material_params.decal_inverse * vec4(worldPos, 1.0)).xyz;

    vec3 outside = step(vec3(0.5), abs(local));
    if (max(outside.x, max(outside.y, outside.z)) > 0.0) {
      discard;
    }

    float verticalMask = 1.0 - smoothstep(0.14, 0.24, local.y);
    if (verticalMask <= 0.002) {
      discard;
    }

    float rangeNorm = max(material_params.cone_range_norm, 0.001);
    vec2 apex = vec2(0.0, -0.5 * rangeNorm);
    vec2 rel = local.xz - apex;
    if (rel.y < 0.0) {
      discard;
    }

    float r = length(rel) / rangeNorm;
    float angle = abs(atan(rel.x, rel.y));
    if (r > 1.0 || angle > material_params.half_angle_rad) {
      discard;
    }

    float stripePattern = step(0.48, fract((rel.x + rel.y) * 22.0));
    float isOuter = step(0.52, r);
    float fillWeight = mix(1.0, mix(0.32, 1.0, stripePattern), isOuter);

    float arcRim = smoothstep(0.965, 0.995, r);
    float sideRim = smoothstep(
      material_params.half_angle_rad - 0.02,
      material_params.half_angle_rad,
      angle
    );
    float boundaryStroke = max(arcRim, sideRim * 0.85);

    vec4 tint = mix(
      material_params.cone_color,
      material_params.alert_color,
      clamp(material_params.alert_mix, 0.0, 1.0)
    );

    vec3 rgb = tint.rgb + vec3(0.35, 0.35, 0.35) * boundaryStroke;
    float alpha = clamp(
      (tint.a * fillWeight + boundaryStroke * 0.45) *
        material_params.decal_fade *
        verticalMask,
      0.0,
      1.0
    );

    material.base_color = vec4(rgb, alpha);
    PrepareMaterial(material);
  }
}
