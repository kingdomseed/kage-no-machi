material {
  name: "HarborWater",
  shading_model: lit,
  blending: alpha,
  culling: back,
  depth_write: false,
  engine_inputs: [scene_color, scene_depth],
  parameters: [
    { type: vec4, name: shallow_color, hint: source_color, default: [0.022, 0.088, 0.112, 0.90] },
    { type: vec4, name: deep_color, hint: source_color, default: [0.008, 0.024, 0.056, 0.98] },
    { type: vec4, name: foam_color, hint: source_color, default: [0.92, 0.89, 0.84, 0.94] },
    { type: float, name: gust_strength, default: 1.0 },
    { type: float, name: time_sec, default: 0.0 },
    { type: float, name: night_mix, default: 0.0 }
  ]
}

vertex {
  void Vertex(inout VertexInputs vertex) {
    float t = material_params.time_sec;
    vec3 wp = vertex.world_position;
    float distDamp = 1.0 - smoothstep(105.0, 220.0, length(wp.xz));
    float gust = clamp(material_params.gust_strength, 0.5, 1.5);
    float ampGain = distDamp * gust;

    const vec2 dirs[4] = vec2[4](
      vec2(-0.78, -0.62),
      vec2(-0.34, 0.94),
      vec2(-0.92, 0.39),
      vec2(0.42, -0.91)
    );
    const float ks[4] = float[4](0.39, 0.60, 1.02, 1.54);
    const float amps[4] = float[4](0.14, 0.09, 0.048, 0.028);
    const float qs[4] = float[4](0.24, 0.22, 0.18, 0.16);
    const float speeds[4] = float[4](1.35, 1.68, 2.05, 2.45);

    vec2 dispXZ = vec2(0.0);
    float dispY = 0.0;
    float dHx = 0.0;
    float dHz = 0.0;
    float steepAcc = 0.0;
    for (int i = 0; i < 4; i++) {
      float a = amps[i] * ampGain;
      float ph = dot(wp.xz, dirs[i]) * ks[i] - t * speeds[i];
      float c = cos(ph);
      float s = sin(ph);
      dispXZ += dirs[i] * (qs[i] * a * c);
      dispY += a * s;
      float ak = a * ks[i];
      dHx += dirs[i].x * ak * c;
      dHz += dirs[i].y * ak * c;
      steepAcc += qs[i] * ak * s;
    }

    vertex.world_position = vec3(wp.x + dispXZ.x, wp.y + dispY, wp.z + dispXZ.y);
    vertex.world_normal = normalize(vec3(-dHx, max(0.35, 1.0 - steepAcc), -dHz));
  }
}

fragment {
  precision highp float;

  float FastHash2(vec2 p, float seed) {
    vec3 p3 = fract(
      vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973) +
          vec3(seed * 0.0173, seed * 0.0317, seed * 0.0113)
    );
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
  }

  float FastVal2(vec2 p, float seed) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = FastHash2(i, seed);
    float b = FastHash2(i + vec2(1.0, 0.0), seed);
    float c = FastHash2(i + vec2(0.0, 1.0), seed);
    float d = FastHash2(i + vec2(1.0, 1.0), seed);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 2.0 - 1.0;
  }

  float FastFbm2_2(vec2 p, float seed) {
    return FastVal2(p, seed) * 0.6667 +
        FastVal2(p * 2.03 + 11.7, seed + 19.0) * 0.3333;
  }

  vec2 EvaluateHarborSwell(
    vec2 p,
    float t,
    float gust,
    float mipFade,
    out float waveHeight
  ) {
    // Domain-warped 4-wave directional swells matching vertex displacement
    vec2 eddyWarp = vec2(
      FastFbm2_2(p * 0.065 + vec2(0.0, t * 0.055), 311.0),
      FastFbm2_2(p * 0.065 + vec2(11.3, -t * 0.045), 419.0)
    ) * 1.35;
    vec2 wp = p + eddyWarp;

    const vec2 dirs[4] = vec2[4](
      vec2(-0.78, -0.62),
      vec2(-0.34, 0.94),
      vec2(-0.92, 0.39),
      vec2(0.42, -0.91)
    );
    const float ks[4] = float[4](0.39, 0.60, 1.02, 1.54);
    const float amps[4] = float[4](0.14, 0.09, 0.048, 0.028);
    const float speeds[4] = float[4](1.35, 1.68, 2.05, 2.45);

    float gustScale = clamp(gust, 0.5, 1.5);
    vec2 grad = vec2(0.0);
    float h = 0.0;
    for (int i = 0; i < 4; i++) {
      float weight = i >= 2 ? mix(0.45, 1.0, mipFade) : 1.0;
      float amp = amps[i] * gustScale * weight;
      float ph = dot(wp, dirs[i]) * ks[i] - t * speeds[i];
      h += amp * sin(ph);
      grad += dirs[i] * (amp * ks[i] * cos(ph));
    }
    waveHeight = h;

    // Multi-scale capillary chop via finite differences for crisp surface sparkle
    const vec2 eps = vec2(0.08, 0.0);
    vec2 cpA = wp * 0.72 + vec2(-t * 0.48, t * 0.28);
    vec2 cpB = wp * 1.68 + vec2(t * 0.40, -t * 0.58);
    float hC = FastVal2(cpA, 733.0) * 0.60 + FastVal2(cpB, 617.0) * 0.40 * mipFade;
    float hX = FastVal2(cpA + eps.xy, 733.0) * 0.60 + FastVal2(cpB + eps.xy * 1.3, 617.0) * 0.40 * mipFade;
    float hY = FastVal2(cpA + eps.yx, 733.0) * 0.60 + FastVal2(cpB + eps.yx * 1.3, 617.0) * 0.40 * mipFade;
    vec2 chopGrad = vec2(hX - hC, hY - hC) / eps.x;

    float gustEnv = 0.62 + 0.38 * FastVal2(p * 0.045 + vec2(t * 0.06, -t * 0.04), 211.0);
    float chopGain = 0.16 * (0.58 + 0.42 * gustScale * gustEnv) * mix(0.35, 1.0, mipFade);
    grad += chopGrad * chopGain;
    return grad;
  }

  void Surface(inout MaterialInputs material) {
    vec3 wp = GetWorldPosition();
    vec3 geomNormal = normalize(GetWorldNormal());
    vec3 viewDir = normalize(GetViewDirection());
    float t = material_params.time_sec > 0.0001 ? material_params.time_sec : GetTime();
    float night = clamp(material_params.night_mix, 0.0, 1.0);

    float footprint = clamp(length(fwidth(wp)), 0.002, 2.0);
    float mipFade = 1.0 - smoothstep(0.28, 1.45, footprint);

    float distFade = mix(0.40, 1.0, 1.0 - smoothstep(80.0, 210.0, length(wp.xz)));
    float waveHeight = 0.0;
    vec2 waveGrad = EvaluateHarborSwell(
      wp.xz,
      t,
      material_params.gust_strength,
      mipFade,
      waveHeight
    ) * distFade;
    vec3 baseUp = normalize(mix(vec3(0.0, 1.0, 0.0), geomNormal, 0.35));
    vec3 rippledNormal = normalize(
      baseUp + vec3(waveGrad.x, 0.0, waveGrad.y)
    );

    bool hasSceneDepth = frag_info.scene_inputs.y > 0.5;
    float fragDepth = GetFragmentViewDepth();
    float unrefractedDepth = hasSceneDepth ? GetSceneDepth(vec2(0.0)) : (fragDepth + 3.0);
    float viewCosY = clamp(abs(viewDir.y) * 1.15, 0.42, 1.0);
    float preThickness = hasSceneDepth ? max(0.0, unrefractedDepth - fragDepth) * viewCosY : 3.0;

    float refractStrength = clamp(preThickness * 0.040, 0.0, 0.015);
    vec2 candidateOffset = rippledNormal.xz * refractStrength;
    float candidateDepth = hasSceneDepth ? GetSceneDepth(candidateOffset) : unrefractedDepth;
    bool foregroundBlocked = candidateDepth < fragDepth + 0.005;
    vec2 refractUvOffset = foregroundBlocked ? vec2(0.0) : candidateOffset;
    float validSceneDepth = foregroundBlocked ? unrefractedDepth : candidateDepth;

    float rawThickness = validSceneDepth < 1.0e5 ? max(0.0, validSceneDepth - fragDepth) : 12.0;
    float thickness = hasSceneDepth ? clamp(rawThickness * viewCosY, 0.0, 12.0) : 3.0;
    float shoreNoise = FastFbm2_2(wp.xz * 0.45 + vec2(t * 0.09, -t * 0.06), 577.0);
    float organicThickness = max(0.0, thickness + shoreNoise * 0.22);
    float shoreFeather = hasSceneDepth ? smoothstep(0.0, 0.52, organicThickness) : 1.0;
    float glintGate = smoothstep(0.06, 0.34, organicThickness);

    // Beer-Lambert shallow jade harbor transitioning to deep Prussian bay indigo
    vec3 activeTransmittance = exp(-vec3(2.2, 0.95, 0.72) * thickness);
    float depthT = clamp(1.0 - exp(-thickness * 1.10), 0.0, 1.0);

    vec3 shallowJade = material_params.shallow_color.rgb;
    vec3 deepPrussian = material_params.deep_color.rgb;
    vec3 nightPrussian = vec3(0.006, 0.016, 0.042);
    vec3 waterBodyColor = mix(shallowJade, mix(deepPrussian, nightPrussian, night), depthT);

    // Animated shoreline/rock/ship surf collar + receding swash + constructive crest lace
    float lapMask = (1.0 - smoothstep(0.12, 0.72, organicThickness)) *
        smoothstep(0.015, 0.06, organicThickness);
    float swashPhase = sin(organicThickness * 7.5 - t * 2.3 + shoreNoise * 3.0);
    float secondarySwash =
        (1.0 - smoothstep(0.35, 1.85, organicThickness)) *
        smoothstep(0.25, 0.48, organicThickness) *
        smoothstep(0.15, 0.85, swashPhase);
    float foamNoiseA = FastVal2(wp.xz * 2.2 + vec2(t * 0.38, -t * 0.26), 503.0) * 0.5 + 0.5;
    float foamNoiseB = FastVal2(wp.xz * 5.6 - vec2(t * 0.54, t * 0.32), 521.0) * 0.5 + 0.5;
    float foamPattern = smoothstep(0.30, 0.78, foamNoiseA * 0.62 + foamNoiseB * 0.38);
    float crestFoam = smoothstep(0.18, 0.32, waveHeight) * foamPattern * 0.26 * distFade;
    float foamStrength = clamp(
      (lapMask * 0.92 + secondarySwash * 0.65) * foamPattern * glintGate + crestFoam,
      0.0,
      0.86
    );

    // Sun direction & crisp liquid Fresnel with subsurface crest-trough contrast
    vec3 rawLD = frag_info.directional_light_direction.xyz;
    float lenLD2 = dot(rawLD, rawLD);
    vec3 toSun = (frag_info.has_directional_light > 0.5 && lenLD2 > 1e-6)
        ? (-rawLD * inversesqrt(lenLD2))
        : normalize(vec3(0.855, 0.23, -0.437));
    vec3 sunTint = frag_info.has_directional_light > 0.5
        ? clamp(frag_info.directional_light_color.rgb, vec3(0.18), vec3(1.45, 1.15, 0.88))
        : vec3(1.0, 0.72, 0.42);

    float nDotV = clamp(dot(rippledNormal, viewDir), 0.0, 1.0);
    float fresnel = 0.04 + 0.96 * pow(1.0 - nDotV, 4.2);

    vec2 sunXZ = length(toSun.xz) > 1e-4 ? normalize(toSun.xz) : vec2(0.89, -0.45);
    float crestMask = smoothstep(-0.08, 0.24, waveHeight);
    float sunFacing = clamp(dot(rippledNormal.xz, sunXZ) * 2.0 + 0.40, 0.0, 1.0);
    vec3 subsurfaceCrest = vec3(0.036, 0.175, 0.195) * mix(1.0, 0.25, night);
    waterBodyColor = mix(waterBodyColor, subsurfaceCrest, crestMask * sunFacing * 0.62);
    float waveFacet = clamp(dot(waveGrad, sunXZ) * 2.4, -0.28, 0.42);
    waterBodyColor *= (1.0 + waveFacet * 0.48);

    vec3 reflDir = reflect(-viewDir, rippledNormal);
    float horizonWarm = pow(clamp(dot(reflDir, toSun) * 0.5 + 0.5, 0.0, 1.0), 3.4);
    vec3 duskSkyRefl = mix(vec3(0.048, 0.082, 0.155), sunTint * vec3(0.42, 0.28, 0.18), horizonWarm);
    vec3 nightSkyRefl = mix(vec3(0.028, 0.056, 0.118), vec3(0.22, 0.34, 0.56), horizonWarm * 0.55);
    vec3 skyReflectColor = mix(duskSkyRefl, nightSkyRefl, night);

    vec3 envReflection = skyReflectColor;
    vec3 reflectedRadiance = envReflection *
        (fresnel * mix(0.42, 0.62, night) + pow(1.0 - nDotV, 4.0) * 0.06) *
        glintGate;

    // Crisp sun-glitter sparkle path confined to reflected sun column
    vec3 halfVec = normalize(toSun + viewDir);
    float nDotH = max(dot(rippledNormal, halfVec), 0.0);
    float glintCellA = FastVal2(wp.xz * 1.45 + vec2(t * 0.38, -t * 0.28), 811.0) * 0.5 + 0.5;
    float glintCellB = FastVal2(wp.xz * 3.60 - vec2(t * 0.52, t * 0.44), 853.0) * 0.5 + 0.5;
    float sparkleMask = smoothstep(0.56, 0.88, glintCellA * 0.55 + glintCellB * 0.45);
    float sunGlintPin = pow(nDotH, 520.0) * (0.45 + 1.45 * sparkleMask);
    float sunGlintTight = pow(nDotH, 300.0) * (0.09 + 0.56 * sparkleMask);
    float broadSheen = pow(max(dot(reflDir, toSun), 0.0), 26.0) * 0.025;
    float elevGate = smoothstep(-0.02, 0.14, toSun.y);

    vec3 glitterTint = mix(
      sunTint * vec3(1.25, 0.78, 0.34),
      vec3(0.45, 0.65, 0.95),
      night
    );
    vec3 sunPath = glitterTint *
        (sunGlintPin + sunGlintTight + broadSheen) *
        mix(1.0, 0.40, night) *
        elevGate *
        (1.0 - foamStrength * 0.80) *
        glintGate;
    sunPath = sunPath / (vec3(1.0) + sunPath * 0.72);

    vec3 outBaseRgb;
    vec3 outEmissive;
    float outAlpha;

    if (frag_info.scene_inputs.x > 0.5) {
      vec3 sceneBedColor = GetSceneColor(refractUvOffset);
      float bedFade = smoothstep(3.8, 0.15, thickness);
      vec3 transmittedBed = sceneBedColor *
          activeTransmittance *
          (1.0 - fresnel * 0.85) *
          (1.0 - foamStrength) *
          bedFade;
      vec3 inScatteredBody = waterBodyColor * (vec3(1.0) - activeTransmittance);
      outBaseRgb = mix(inScatteredBody, material_params.foam_color.rgb * 0.90, foamStrength);
      outAlpha = clamp(mix(max(0.76, fresnel), 0.99, depthT), 0.0, 1.0);
      outAlpha = mix(outAlpha, max(outAlpha, 0.95), foamStrength);
      outEmissive = transmittedBed * mix(0.68, 1.0, depthT) + reflectedRadiance + sunPath;
    } else {
      outBaseRgb = mix(waterBodyColor, material_params.foam_color.rgb * 0.90, foamStrength);
      outAlpha = clamp(mix(max(0.68, fresnel), 0.98, depthT), 0.0, 1.0);
      outAlpha = mix(outAlpha, max(outAlpha, 0.95), foamStrength);
      outEmissive = reflectedRadiance + sunPath;
    }

    float distXZ = length(wp.xz);
    float horizonMist = smoothstep(130.0, 360.0, distXZ);
    vec3 activeHorizon = mix(
      mix(vec3(0.15, 0.13, 0.19), vec3(0.38, 0.24, 0.20), pow(horizonWarm, 1.15)),
      vec3(0.018, 0.036, 0.082),
      night
    );
    outEmissive = mix(outEmissive, activeHorizon, horizonMist * 0.85);
    outBaseRgb = mix(outBaseRgb, activeHorizon * 0.55, horizonMist * 0.85);

    float horizonAlpha = 1.0 - smoothstep(320.0, 520.0, distXZ);
    outAlpha *= shoreFeather * horizonAlpha;
    outEmissive *= shoreFeather * horizonAlpha;

    material.base_color = vec4(outBaseRgb, outAlpha);
    material.emissive = outEmissive;
    material.normal = rippledNormal;
    material.metallic = 0.02;
    material.roughness = mix(0.09, 0.56, foamStrength);
    material.specular = mix(0.76, 0.20, foamStrength);
    material.occlusion = mix(0.92, 1.0, 1.0 - depthT * 0.22);

    PrepareMaterial(material);
  }
}
